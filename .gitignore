# Python caches
__pycache__/
*.py[cod]

# Virtual environments
venv/
.venv/
.test_venv/

# macOS metadata
.DS_Store

# Local editor settings
.vscode/

# Logs and temp files (루트의 임시 .log는 무시, logs/ 폴더는 git에 포함)
*.log
!logs/**/*.log

# Google Sheets credentials
gspread-service-account.json

# TradingView 로그인 세션 (비밀 쿠키 포함)
charts/auth.json
charts/.browser_profile/

# 백테스트 디스크 캐시 (용량이 크므로 git에서 제외)
data/cache/

# 환경변수 파일 (비밀값 포함)
.env

# Atomic write 백업/임시 파일
*.json.bak
*.tmp



tv_state.json

# TradingView 차트 스크린샷 (용량 큼, CI에서 매번 생성)
charts/screenshots/

# 핸드오프 폴더 (다른 컴퓨터에서 파일 이전 시 임시 사용)
project_1_handoff*/

# Tier 3 연구 패널 (용량 큼, scripts/build_research_panel.py로 재생성 가능)
data/research/

# 백테스트 실행 로그 (재생성 가능)
output/logs/
