forms, and insurance agents. The company was formerly known as Brooke (Holdco1) Inc. and changed its name to Jackson Financial Inc. in July 2020. Jackson Financial Inc. was incorporated in 2006 and is headquartered in Lansing, Michigan.","detail":{"as_of":"2026-11-06","valuation":{"pe":10.81,"fpe":4.15,"peg":null,"ps":1.3,"pb":1.1,"ev_ebitda":null,"ind":{"pe":11.17,"fpe":8.75,"peg":0.91,"ps":1.04,"pb":1.6,"ev_ebitda":9.05},"n_peers":14,"industry":"Insurance - Life"},"analyst":{"n":4,"mean":148.25,"median":147.0,"high":163.0,"low":136.0,"rec_mean":2.25,"rec_key":"buy","rec":{"strong_buy":1,"buy":1,"hold":2,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-02-19","est":4.86,"act":4.65,"surprise":-4.38},{"date":"2025-05-07","est":3.16,"act":-0.48,"surprise":-115.21},{"date":"2025-08-04","est":4.64,"act":4.87,"surprise":4.98},{"date":"2025-11-04","est":5.45,"act":6.16,"surprise":12.97},{"date":"2026-02-18","est":5.86,"act":6.61,"surprise":12.75},{"date":"2026-05-05","est":5.96,"act":5.15,"surprise":-13.6},{"date":"2026-08-03","est":5.76,"act":7.3,"surprise":26.81},{"date":"2026-11-03","est":7.24,"act":7.55,"surprise":4.24}],"revenue":[{"end":"2025-09-30","revenue":1349000000.0,"eps_gaap":0.92},{"end":"2025-12-31","revenue":1922000000.0,"eps_gaap":-3.13},{"end":"2026-03-31","revenue":2909000000.0,"eps_gaap":-6.24},{"end":"2026-06-30","revenue":160000000.0,"eps_gaap":9.16},{"end":"2026-09-30","revenue":1519000000.0,"eps_gaap":12.37}],"next":{"date":null,"eps_est":7.461,"eps_year_ago":6.61,"n":1,"rev_est":2064000000.0,"rev_growth":0.0382}}}}