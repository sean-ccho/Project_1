In addition, the company also operates as a clinical-stage pharmaceutical company, that focuses on the discovery, development, and commercialization of novel therapeutics for rare endocrine diseases and endocrine-related tumors. The company sells its products primarily to specialty pharmacy and distributors, wholesalers, retail pharmacies, hospitals, and clinics. Vertex Pharmaceuticals Incorporated has a strategic collaboration with AbCellera Biologics Inc. to research, develop, manufacture, and commercialize multispecific T-cell engagers (TCEs) for autoimmune diseases and other conditions. Vertex Pharmaceuticals Incorporated was founded in 1989 and is headquartered in Boston, Massachusetts.","detail":{"as_of":"2026-11-20","valuation":{"pe":33.14,"fpe":25.86,"peg":2.27,"ps":10.08,"pb":6.25,"ev_ebitda":25.63,"ind":{"pe":25.67,"fpe":20.88,"peg":1.68,"ps":9.62,"pb":5.2,"ev_ebitda":25.85},"n_peers":144,"industry":"Biotechnology"},"analyst":{"n":28,"mean":595.36,"median":609.5,"high":725.0,"low":350.0,"rec_mean":1.62,"rec_key":"buy","rec":null},"quarters":{"eps":[{"date":"2025-02-10","est":4.02,"act":3.98,"surprise":-1.0},{"date":"2025-05-05","est":4.29,"act":4.06,"surprise":-5.44},{"date":"2025-08-04","est":4.25,"act":4.52,"surprise":6.33},{"date":"2025-11-03","est":4.58,"act":4.8,"surprise":4.87},{"date":"2026-02-12","est":5.15,"act":5.03,"surprise":-2.3},{"date":"2026-05-04","est":4.31,"act":4.47,"surprise":3.81},{"date":"2026-08-03","est":4.75,"act":4.73,"surprise":-0.32},{"date":"2026-11-02","est":4.78,"act":4.76,"surprise":-0.5}],"revenue":[{"end":"2025-09-30","revenue":3076400000.0,"eps_gaap":4.2},{"end":"2025-12-31","revenue":3190000000.0,"eps_gaap":4.65},{"end":"2026-03-31","revenue":2986900000.0,"eps_gaap":4.02},{"end":"2026-06-30","revenue":3333900000.0,"eps_gaap":4.31},{"end":"2026-09-30","revenue":3440800000.0,"eps_gaap":2.56}],"next":{"date":null}}},"splits":[["2000-08-24",2.0]],"congress":[{"filed":"2026-09-05","date":"2026-08-26","lag":10,"member":"David 