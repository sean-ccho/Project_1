s and products. It markets its products and services through a direct sales force, representatives, and distributors. The company was formerly known as II-VI Incorporated and changed its name to Coherent Corp. in September 2022. Coherent Corp. was incorporated in 1971 and is headquartered in Saxonburg, Pennsylvania.","detail":{"as_of":"2026-11-13","valuation":{"pe":45.17,"fpe":13.82,"peg":0.48,"ps":5.43,"pb":3.79,"ev_ebitda":29.26,"ind":{"pe":32.19,"fpe":20.9,"peg":0.87,"ps":4.57,"pb":3.75,"ev_ebitda":19.43},"n_peers":14,"industry":"Scientific & Technical Instruments"},"analyst":{"n":25,"mean":371.92,"median":380.0,"high":524.96,"low":228.0,"rec_mean":1.54,"rec_key":"buy","rec":{"strong_buy":5,"buy":17,"hold":4,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-02-05","est":0.67,"act":0.95,"surprise":41.04},{"date":"2025-05-07","est":0.86,"act":0.91,"surprise":6.24},{"date":"2025-08-13","est":0.92,"act":1.0,"surprise":8.7},{"date":"2025-11-05","est":1.04,"act":1.16,"surprise":11.27},{"date":"2026-02-04","est":1.21,"act":1.29,"surprise":6.82},{"date":"2026-05-06","est":1.39,"act":1.41,"surprise":1.12},{"date":"2026-08-12","est":1.62,"act":1.74,"surprise":7.6},{"date":"2026-11-04","est":1.97,"act":2.09,"surprise":5.99}],"revenue":[{"end":"2025-09-30","revenue":1581378000.0,"eps_gaap":1.19},{"end":"2025-12-31","revenue":1685629000.0,"eps_gaap":0.76},{"end":"2026-03-31","revenue":1805641000.0,"eps_gaap":0.97},{"end":"2026-06-30","revenue":2045533000.0,"eps_gaap":1.19},{"end":"2026-09-30","revenue":2370324000.0,"eps_gaap":1.9}],"next":{"date":"2027-02-03","eps_est":2.403,"eps_year_ago":1.29,"n":21,"rev_est":2654037670.0,"rev_growth":0.5745}}},"congress":[{"filed":"2026-09-10","date":"2026-08-18","lag":23,"member":"Gilbert Ray Cisneros, Jr.","party":"D","state":"CA","leader":null,"owner":"self","type":"sell","partial":false,"atype":"ST","low":1001,"high":15000,"amount":"$1,001 - $15,000","url":"https://disclosures-clerk.house.gov/public_disc/ptr-pdfs/2026/2003539