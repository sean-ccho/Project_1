r credit unions. It provides digital products and services under the Banno Digital Platform, and electronic payment solutions; hardware systems; implementation, training, and support and services; and data and transaction processing, and software licensing and related services, as well as professional services. The company was founded in 1976 and is headquartered in Monett, Missouri.","detail":{"as_of":"2026-11-06","valuation":{"pe":23.8,"fpe":21.67,"peg":2.19,"ps":4.67,"pb":5.92,"ev_ebitda":17.75,"ind":{"pe":19.36,"fpe":12.29,"peg":1.19,"ps":1.35,"pb":2.88,"ev_ebitda":9.62},"n_peers":40,"industry":"Information Technology Services"},"analyst":{"n":19,"mean":188.37,"median":193.0,"high":209.0,"low":158.0,"rec_mean":1.76,"rec_key":"buy","rec":{"strong_buy":4,"buy":11,"hold":6,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-02-04","est":1.32,"act":1.35,"surprise":2.09},{"date":"2025-05-06","est":1.33,"act":1.45,"surprise":8.66},{"date":"2025-08-19","est":1.5,"act":1.56,"surprise":4.08},{"date":"2025-11-04","est":1.65,"act":1.86,"surprise":12.81},{"date":"2026-02-03","est":1.42,"act":1.66,"surprise":17.07},{"date":"2026-05-05","est":1.42,"act":1.56,"surprise":10.37},{"date":"2026-08-18","est":1.44,"act":1.53,"surprise":6.4},{"date":"2026-11-03","est":2.01,"act":2.13,"surprise":6.08}],"revenue":[{"end":"2025-06-30","revenue":615372000.0,"eps_gaap":null},{"end":"2025-09-30","revenue":644738000.0,"eps_gaap":1.97},{"end":"2025-12-31","revenue":619334000.0,"eps_gaap":1.72},{"end":"2026-03-31","revenue":636245000.0,"eps_gaap":1.71},{"end":"2026-06-30","revenue":644023000.0,"eps_gaap":1.57}],"next":{"date":"2027-02-02","eps_est":1.7567,"eps_year_ago":1.6623,"n":3,"rev_est":658117690.0,"rev_growth":0.0626}}},"congress":[{"filed":"2026-07-02","date":"2026-06-16","lag":16,"member":"Gilbert Ray Cisneros, Jr.","party":"D","state":"CA","leader":null,"owner":"self","type":"buy","partial":false,"atype":"ST","low":1001,"high":15000,"amount":"$1,001 - $15,000","url":"https:/