ors, and developers for various property types, including critical environments and data centers, offices, industrial and warehouses, residential properties, infrastructure projects, retail and shopping malls, logistics, and military housing and transportation centers; and hotels and hospitality, cultural, educational, government, healthcare and laboratory, and sports facilities. The company was formerly known as LaSalle Partners Incorporated and changed its name to Jones Lang LaSalle Incorporated in March 1999. Jones Lang LaSalle Incorporated was incorporated in 1997 and is headquartered in Chicago, Illinois.","detail":{"as_of":"2026-11-06","valuation":{"pe":16.08,"fpe":12.87,"peg":0.92,"ps":0.6,"pb":2.21,"ev_ebitda":10.94,"ind":{"pe":39.2,"fpe":15.05,"peg":0.44,"ps":0.79,"pb":2.2,"ev_ebitda":12.51},"n_peers":14,"industry":"Real Estate Services"},"analyst":{"n":10,"mean":415.9,"median":416.0,"high":496.0,"low":335.0,"rec_mean":1.83,"rec_key":"buy","rec":{"strong_buy":2,"buy":6,"hold":4,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-02-19","est":6.01,"act":6.15,"surprise":2.33},{"date":"2025-05-07","est":2.18,"act":2.31,"surprise":5.85},{"date":"2025-08-06","est":3.2,"act":3.3,"surprise":3.01},{"date":"2025-11-05","est":4.27,"act":4.5,"surprise":5.49},{"date":"2026-02-18","est":7.36,"act":8.71,"surprise":18.29},{"date":"2026-04-30","est":3.01,"act":3.43,"surprise":14.08},{"date":"2026-07-30","est":4.55,"act":5.26,"surprise":15.61},{"date":"2026-10-28","est":6.18,"act":6.76,"surprise":9.35}],"revenue":[{"end":"2025-09-30","revenue":6510400000.0,"eps_gaap":4.61},{"end":"2025-12-31","revenue":7608700000.0,"eps_gaap":8.34},{"end":"2026-03-31","revenue":6386500000.0,"eps_gaap":3.33},{"end":"2026-06-30","revenue":6927900000.0,"eps_gaap":4.59},{"end":"2026-09-30","revenue":7281200000.0,"eps_gaap":6.85}],"next":{"date":null,"eps_est":10.2154,"eps_year_ago":8.71,"n":9,"rev_est":8325433209.0,"rev_growth":0.0942}}},"congress":[{"filed":"2026-04-06","date":"2026-03