works, and directly to manufacturing companies and retail customers. PPG Industries, Inc. was incorporated in 1883 and is headquartered in Pittsburgh, Pennsylvania.","detail":{"as_of":"2026-11-13","valuation":{"pe":17.21,"fpe":14.16,"peg":1.67,"ps":1.62,"pb":3.19,"ev_ebitda":11.97,"ind":{"pe":28.77,"fpe":15.53,"peg":1.86,"ps":1.81,"pb":2.79,"ev_ebitda":11.55},"n_peers":36,"industry":"Specialty Chemicals"},"analyst":{"n":22,"mean":130.14,"median":130.5,"high":140.0,"low":115.0,"rec_mean":2.12,"rec_key":"buy","rec":{"strong_buy":2,"buy":10,"hold":13,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-01-30","est":1.63,"act":1.61,"surprise":-1.48},{"date":"2025-04-29","est":1.62,"act":1.72,"surprise":6.05},{"date":"2025-07-29","est":2.22,"act":2.22,"surprise":-0.01},{"date":"2025-10-28","est":2.08,"act":2.13,"surprise":2.26},{"date":"2026-01-27","est":1.58,"act":1.51,"surprise":-4.37},{"date":"2026-04-28","est":1.77,"act":1.83,"surprise":3.65},{"date":"2026-07-28","est":2.25,"act":2.23,"surprise":-1.04},{"date":"2026-10-27","est":2.12,"act":2.25,"surprise":6.04}],"revenue":[{"end":"2025-09-30","revenue":4082000000.0,"eps_gaap":2.0},{"end":"2025-12-31","revenue":3914000000.0,"eps_gaap":1.33},{"end":"2026-03-31","revenue":3930000000.0,"eps_gaap":1.7},{"end":"2026-06-30","revenue":4495000000.0,"eps_gaap":1.95},{"end":"2026-09-30","revenue":4353000000.0,"eps_gaap":2.02}],"next":{"date":"2027-01-26","eps_est":1.6843,"eps_year_ago":1.51,"n":21,"rev_est":4036493880.0,"rev_growth":0.0313}}},"congress":[{"filed":"2026-10-05","date":"2026-09-11","lag":24,"member":"Lloyd Doggett","party":"D","state":"TX","leader":null,"owner":"self","type":"buy","partial":false,"atype":"ST","low":1001,"high":15000,"amount":"$1,001 - $15,000","url":"https://disclosures-clerk.house.gov/public_disc/ptr-pdfs/2026/20035580.pdf"},{"filed":"2026-07-06","date":"2026-06-12","lag":24,"member":"Lloyd Doggett","party":"D","state":"TX","leader":null,"owner":"self","type":"buy","partial":false,"atype":