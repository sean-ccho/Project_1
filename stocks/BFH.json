 and Bread Savings brands. The company was formerly known as Alliance Data Systems Corporation and changed its name to Bread Financial Holdings, Inc. in March 2022. Bread Financial Holdings, Inc. was incorporated in 1995 and is headquartered in Columbus, Ohio.","detail":{"as_of":"2026-11-13","valuation":{"pe":7.73,"fpe":7.11,"peg":2.08,"ps":1.39,"pb":1.09,"ev_ebitda":null,"ind":{"pe":11.73,"fpe":8.2,"peg":0.89,"ps":2.23,"pb":2.13,"ev_ebitda":12.69},"n_peers":26,"industry":"Credit Services"},"analyst":{"n":16,"mean":114.88,"median":115.0,"high":132.0,"low":86.0,"rec_mean":2.18,"rec_key":"buy","rec":{"strong_buy":1,"buy":7,"hold":8,"sell":0,"strong_sell":1}},"quarters":{"eps":[{"date":"2025-01-30","est":0.37,"act":0.41,"surprise":9.51},{"date":"2025-04-24","est":2.23,"act":2.9,"surprise":30.09},{"date":"2025-07-24","est":1.96,"act":3.14,"surprise":60.55},{"date":"2025-10-23","est":2.11,"act":4.02,"surprise":90.32},{"date":"2026-01-29","est":0.48,"act":2.07,"surprise":334.3},{"date":"2026-04-23","est":3.05,"act":4.18,"surprise":37.03},{"date":"2026-07-22","est":2.77,"act":3.55,"surprise":28.26},{"date":"2026-10-21","est":3.23,"act":3.84,"surprise":18.78}],"revenue":[{"end":"2025-09-30","revenue":971000000.0,"eps_gaap":3.96},{"end":"2025-12-31","revenue":975000000.0,"eps_gaap":null},{"end":"2026-03-31","revenue":1018000000.0,"eps_gaap":4.15},{"end":"2026-06-30","revenue":993000000.0,"eps_gaap":3.55},{"end":"2026-09-30","revenue":1017000000.0,"eps_gaap":3.82}],"next":{"date":"2027-01-28","eps_est":1.5215,"eps_year_ago":2.07,"n":11,"rev_est":1001499260.0,"rev_growth":0.0272}}}}