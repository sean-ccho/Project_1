, related aftermarket customers, and industrial applications. In addition, the company offers transmissions, clutches, hybrid power systems, superchargers, engine valves and valve actuation systems, locking and limited slip differentials, transmission controls, and fuel vapor components for the vehicle industry; and voltage inverters, converters, fuses, circuit protection units, vehicle controls, power distribution systems, fuel tank isolation valves, and commercial vehicle hybrid systems. The company was formerly known as Abeiron Limited. The company was founded in 1911 and is based in Dublin, Ireland.","detail":{"as_of":"2026-11-13","valuation":{"pe":35.26,"fpe":21.48,"peg":1.92,"ps":4.29,"pb":6.54,"ev_ebitda":22.62,"ind":{"pe":29.38,"fpe":19.19,"peg":1.72,"ps":3.26,"pb":3.99,"ev_ebitda":16.24},"n_peers":44,"industry":"Specialty Industrial Machinery"},"analyst":{"n":27,"mean":471.16,"median":485.0,"high":539.0,"low":333.0,"rec_mean":1.59,"rec_key":"buy","rec":{"strong_buy":5,"buy":18,"hold":4,"sell":0,"strong_sell":1}},"quarters":{"eps":[{"date":"2025-01-31","est":2.81,"act":2.83,"surprise":0.72},{"date":"2025-05-02","est":2.71,"act":2.72,"surprise":0.55},{"date":"2025-08-05","est":2.92,"act":2.95,"surprise":0.95},{"date":"2025-11-04","est":3.05,"act":3.07,"surprise":0.51},{"date":"2026-02-03","est":3.32,"act":3.33,"surprise":0.34},{"date":"2026-05-05","est":2.73,"act":2.81,"surprise":2.9},{"date":"2026-07-31","est":3.08,"act":3.15,"surprise":2.39},{"date":"2026-11-03","est":3.55,"act":3.68,"surprise":3.71}],"revenue":[{"end":"2025-06-30","revenue":7028000000.0,"eps_gaap":null},{"end":"2025-09-30","revenue":6988000000.0,"eps_gaap":2.59},{"end":"2025-12-31","revenue":7055000000.0,"eps_gaap":2.91},{"end":"2026-03-31","revenue":7451000000.0,"eps_gaap":2.22},{"end":"2026-09-30","revenue":8947000000.0,"eps_gaap":2.77}],"next":{"date":"2027-02-02","eps_est":4.1375,"eps_year_ago":3.33,"n":18,"rev_est":8824948700.0,"rev_growth":0.2509}}},"congress":[{"filed":"2026-11-12",