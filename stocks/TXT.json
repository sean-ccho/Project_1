rs. The Textron eAviation segment manufactures and sells light aircraft and gliders with electric and combustion engines; and provides other research and development initiatives related to sustainable aviation solutions. The Finance segment offers financing services to purchase new and pre-owned aviation aircraft and Bell helicopters. Textron Inc. was founded in 1923 and is headquartered in Providence, Rhode Island.","detail":{"as_of":"2026-11-06","valuation":{"pe":15.03,"fpe":11.58,"peg":1.0,"ps":0.92,"pb":1.74,"ev_ebitda":9.9,"ind":{"pe":33.11,"fpe":25.36,"peg":1.38,"ps":3.04,"pb":3.99,"ev_ebitda":19.03},"n_peers":49,"industry":"Aerospace & Defense"},"analyst":{"n":15,"mean":101.27,"median":100.0,"high":115.0,"low":92.0,"rec_mean":2.19,"rec_key":"buy","rec":null},"quarters":{"eps":[{"date":"2025-01-22","est":1.25,"act":1.34,"surprise":6.81},{"date":"2025-04-24","est":1.14,"act":1.28,"surprise":12.56},{"date":"2025-07-24","est":1.45,"act":1.55,"surprise":7.18},{"date":"2025-10-23","est":1.46,"act":1.55,"surprise":6.43},{"date":"2026-01-28","est":1.7,"act":1.73,"surprise":1.53},{"date":"2026-04-30","est":1.3,"act":1.45,"surprise":11.26},{"date":"2026-07-28","est":1.55,"act":1.62,"surprise":4.82},{"date":"2026-10-29","est":1.44,"act":1.76,"surprise":21.83}],"revenue":[{"end":"2025-09-30","revenue":3602000000.0,"eps_gaap":1.31},{"end":"2025-12-31","revenue":4175000000.0,"eps_gaap":1.3267},{"end":"2026-03-31","revenue":3695000000.0,"eps_gaap":1.2487},{"end":"2026-06-30","revenue":3827000000.0,"eps_gaap":1.42},{"end":"2026-09-30","revenue":3751000000.0,"eps_gaap":1.56}],"next":{"date":"2027-01-27"}}},"congress":[{"filed":"2026-01-15","date":"2025-12-11","lag":35,"member":"Dan Newhouse","party":"R","state":"WA","leader":null,"owner":"spouse","type":"buy","partial":false,"atype":"ST","low":1001,"high":15000,"amount":"$1,001 - $15,000","url":"https://disclosures-clerk.house.gov/public_disc/ptr-pdfs/2026/20033654.pdf"},{"filed":"2025-11-21","date":"2025-10-30","lag":22,"mem