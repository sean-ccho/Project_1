e diseases; microbiology offerings, such as dehydrated and prepared culture media, collection and transport systems, instrumentation and consumables to detect pathogens in blood, diagnostic and rapid direct specimen tests, quality-control products, and associated products; transplant diagnostics products, including human leukocyte antigen typing and testing for the organ transplant market; and healthcare market channel offerings. Its Laboratory Products and Biopharma Services segment provides laboratory products, research and safety market channel, and pharma services and clinical research. Thermo Fisher Scientific Inc. was founded in 1956 and is headquartered in Waltham, Massachusetts.","detail":{"as_of":"2026-11-13","valuation":{"pe":36.93,"fpe":25.2,"peg":2.03,"ps":5.48,"pb":4.74,"ev_ebitda":24.28,"ind":{"pe":36.31,"fpe":25.98,"peg":1.67,"ps":5.67,"pb":5.01,"ev_ebitda":24.6},"n_peers":30,"industry":"Diagnostics & Research"},"analyst":{"n":25,"mean":756.52,"median":750.0,"high":830.0,"low":590.0,"rec_mean":1.44,"rec_key":"strong_buy","rec":null},"quarters":{"eps":[{"date":"2025-01-30","est":5.94,"act":6.1,"surprise":2.66},{"date":"2025-04-23","est":5.1,"act":5.15,"surprise":0.94},{"date":"2025-07-23","est":5.23,"act":5.36,"surprise":2.55},{"date":"2025-10-22","est":5.5,"act":5.79,"surprise":5.32},{"date":"2026-01-29","est":6.45,"act":6.57,"surprise":1.87},{"date":"2026-04-23","est":5.24,"act":5.44,"surprise":3.79},{"date":"2026-07-23","est":5.71,"act":6.03,"surprise":5.55},{"date":"2026-10-21","est":6.4,"act":6.68,"surprise":4.33}],"revenue":[{"end":"2025-09-30","revenue":11122000000.0,"eps_gaap":4.27},{"end":"2025-12-31","revenue":12215000000.0,"eps_gaap":5.21},{"end":"2026-03-31","revenue":11005000000.0,"eps_gaap":4.43},{"end":"2026-06-30","revenue":11994000000.0,"eps_gaap":4.68},{"end":"2026-09-30","revenue":12137000000.0,"eps_gaap":4.64}],"next":{"date":"2027-01-28"}}},"congress":[{"filed":"2026-08-07","date":"2024-12-12","lag":603,"member":"Michael A. Rulli",