any serves mid-market and enterprise customers, and services providers. Extreme Networks, Inc., was incorporated in 1996 and is headquartered in Morrisville, North Carolina.","detail":{"as_of":"2026-11-06","valuation":{"pe":61.62,"fpe":15.37,"peg":0.76,"ps":2.4,"pb":36.08,"ev_ebitda":30.85,"ind":{"pe":37.43,"fpe":15.37,"peg":0.56,"ps":4.74,"pb":3.13,"ev_ebitda":20.27},"n_peers":20,"industry":"Communication Equipment"},"analyst":{"n":8,"mean":33.62,"median":34.0,"high":38.0,"low":28.0,"rec_mean":1.38,"rec_key":"strong_buy","rec":{"strong_buy":1,"buy":6,"hold":1,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-01-29","est":0.18,"act":0.21,"surprise":19.96},{"date":"2025-04-30","est":0.18,"act":0.21,"surprise":15.45},{"date":"2025-08-06","est":0.22,"act":0.25,"surprise":12.83},{"date":"2025-10-29","est":0.21,"act":0.22,"surprise":2.56},{"date":"2026-01-28","est":0.24,"act":0.26,"surprise":7.9},{"date":"2026-04-29","est":0.24,"act":0.26,"surprise":9.57},{"date":"2026-08-05","est":0.29,"act":0.32,"surprise":10.36},{"date":"2026-10-28","est":0.28,"act":0.33,"surprise":18.55}],"revenue":[{"end":"2025-09-30","revenue":310245000.0,"eps_gaap":0.04},{"end":"2025-12-31","revenue":317925000.0,"eps_gaap":0.06},{"end":"2026-03-31","revenue":316874000.0,"eps_gaap":0.08},{"end":"2026-06-30","revenue":338549000.0,"eps_gaap":0.13},{"end":"2026-09-30","revenue":341094000.0,"eps_gaap":0.12}],"next":{"date":"2027-01-27","eps_est":0.3291,"eps_year_ago":0.26,"n":8,"rev_est":348151830.0,"rev_growth":0.0951}}}}