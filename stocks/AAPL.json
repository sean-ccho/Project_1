rves consumer, small and mid-sized business, education, enterprise, and government markets. The company operates in North and South America, European countries, India, the Middle East, Africa, China mainland, Hong Kong, Taiwan, Japan, Australia, New Zealand, and rest of Asia. The company was formerly known as Apple Computer, Inc. and changed its name to Apple Inc. in January 2007. Apple Inc. was founded in 1976 and is headquartered in Cupertino, California.","detail":{"as_of":"2026-11-06","valuation":{"pe":38.13,"fpe":32.15,"peg":2.83,"ps":10.39,"pb":44.39,"ev_ebitda":29.23,"ind":{"pe":36.47,"fpe":23.95,"peg":null,"ps":1.3,"pb":3.86,"ev_ebitda":9.63},"n_peers":4,"industry":"Consumer Electronics"},"analyst":{"n":39,"mean":332.68,"median":340.0,"high":405.0,"low":250.0,"rec_mean":2.25,"rec_key":"buy","rec":{"strong_buy":6,"buy":18,"hold":14,"sell":3,"strong_sell":3}},"quarters":{"eps":[{"date":"2025-01-30","est":2.34,"act":2.4,"surprise":2.52},{"date":"2025-05-01","est":1.62,"act":1.65,"surprise":1.69},{"date":"2025-07-31","est":1.43,"act":1.57,"surprise":10.12},{"date":"2025-10-30","est":1.77,"act":1.85,"surprise":4.52},{"date":"2026-01-29","est":2.67,"act":2.84,"surprise":6.34},{"date":"2026-04-30","est":1.94,"act":2.01,"surprise":3.46},{"date":"2026-07-30","est":1.89,"act":2.02,"surprise":6.74},{"date":"2026-11-02","est":1.99,"act":2.1,"surprise":5.75}],"revenue":[{"end":"2025-09-30","revenue":102466000000.0,"eps_gaap":1.85},{"end":"2025-12-31","revenue":143756000000.0,"eps_gaap":2.84},{"end":"2026-03-31","revenue":111184000000.0,"eps_gaap":2.01},{"end":"2026-06-30","revenue":109417000000.0,"eps_gaap":2.02},{"end":"2026-09-30","revenue":114477000000.0,"eps_gaap":null}],"next":{"date":"2027-01-28","eps_est":2.9139,"eps_year_ago":1.85,"n":26,"rev_est":156106985780.0,"rev_growth":0.0859}}},"congress":[{"filed":"2026-10-27","date":"2026-10-02","lag":25,"member":"Pete Sessions","party":"R","state":"TX","leader":null,"owner":"spouse","type":"sell","partial":false,"atype"