ic and hydraulic braking systems, electric power, electromechanical actuators, engine exhaust systems and components, fire detection and suppression, flight control systems, fluid conveyance, fuel systems and components, fuel tank inserting systems, hydraulic pumps and motors, hydraulic valves and actuators, pneumatics, seals, sensors, and thermal management products. The company sells its products to original equipment manufacturers, distributors, direct-sales employees. Parker-Hannifin Corporation was founded in 1917 and is headquartered in Cleveland, Ohio.","detail":{"as_of":"2026-11-06","valuation":{"pe":31.53,"fpe":22.6,"peg":2.99,"ps":5.17,"pb":7.25,"ev_ebitda":22.55,"ind":{"pe":29.54,"fpe":18.2,"peg":1.65,"ps":3.16,"pb":3.88,"ev_ebitda":15.73},"n_peers":44,"industry":"Specialty Industrial Machinery"},"analyst":{"n":24,"mean":1152.58,"median":1205.0,"high":1358.0,"low":680.0,"rec_mean":1.73,"rec_key":"buy","rec":{"strong_buy":3,"buy":16,"hold":6,"sell":1,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-01-30","est":6.23,"act":6.53,"surprise":4.88},{"date":"2025-05-01","est":6.72,"act":6.94,"surprise":3.26},{"date":"2025-08-07","est":7.08,"act":7.69,"surprise":8.57},{"date":"2025-11-06","est":6.62,"act":7.22,"surprise":9.01},{"date":"2026-01-29","est":7.17,"act":7.65,"surprise":6.75},{"date":"2026-04-30","est":7.83,"act":8.17,"surprise":4.36},{"date":"2026-08-06","est":8.27,"act":9.27,"surprise":12.15},{"date":"2026-11-05","est":8.17,"act":8.9,"surprise":8.92}],"revenue":[{"end":"2025-09-30","revenue":5084000000.0,"eps_gaap":6.29},{"end":"2025-12-31","revenue":5174000000.0,"eps_gaap":6.6},{"end":"2026-03-31","revenue":5486000000.0,"eps_gaap":7.06},{"end":"2026-06-30","revenue":5755000000.0,"eps_gaap":8.54},{"end":"2026-09-30","revenue":5992000000.0,"eps_gaap":6.92}],"next":{"date":"2027-01-28","eps_est":8.5001,"eps_year_ago":7.65,"n":14,"rev_est":6039728210.0,"rev_growth":0.1673}}},"congress":[{"filed":"2026-09-15","date":"2026-08-11","lag":35,"member":"Byron