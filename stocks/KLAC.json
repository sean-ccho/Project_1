 company offers service programs. It serves semiconductor, and semiconductor-related and electronic device manufacturers. The company operates in China, Taiwan, Korea, North America, Japan, Europe, Israel, and rest of Asia. The company was formerly known as KLA-Tencor Corporation and changed its name to KLA Corporation in July 2019. KLA Corporation was incorporated in 1975 and is headquartered in Milpitas, California.","detail":{"as_of":"2026-11-13","valuation":{"pe":38.18,"fpe":21.46,"peg":1.42,"ps":13.68,"pb":30.43,"ev_ebitda":31.34,"ind":{"pe":37.48,"fpe":18.33,"peg":0.8,"ps":6.37,"pb":3.96,"ev_ebitda":26.49},"n_peers":24,"industry":"Semiconductor Equipment & Materials"},"analyst":{"n":26,"mean":219.62,"median":220.0,"high":275.0,"low":175.0,"rec_mean":1.76,"rec_key":"buy","rec":{"strong_buy":6,"buy":15,"hold":8,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-01-30","est":0.78,"act":0.82,"surprise":5.73},{"date":"2025-04-30","est":0.81,"act":0.84,"surprise":4.03},{"date":"2025-07-31","est":0.86,"act":0.94,"surprise":9.67},{"date":"2025-10-29","est":0.86,"act":0.88,"surprise":2.24},{"date":"2026-01-29","est":0.88,"act":0.89,"surprise":0.59},{"date":"2026-04-29","est":0.92,"act":0.94,"surprise":2.5},{"date":"2026-07-28","est":1.0,"act":1.05,"surprise":5.14},{"date":"2026-10-28","est":1.18,"act":1.22,"surprise":3.55}],"revenue":[{"end":"2025-09-30","revenue":3209696000.0,"eps_gaap":0.847},{"end":"2025-12-31","revenue":3297146000.0,"eps_gaap":0.868},{"end":"2026-03-31","revenue":3415078000.0,"eps_gaap":0.912},{"end":"2026-06-30","revenue":3657556000.0,"eps_gaap":1.04},{"end":"2026-09-30","revenue":4136015000.0,"eps_gaap":1.18}],"next":{"date":"2027-01-28","eps_est":1.4492,"eps_year_ago":0.885,"n":22,"rev_est":4720182520.0,"rev_growth":0.4316}}},"congress":[{"filed":"2026-08-07","date":"2026-07-01","lag":37,"member":"Michael A. Rulli","party":"R","state":"OH","leader":null,"owner":"self","type":"buy","partial":false,"atype":"ST","low":1001,"high":15000,"am