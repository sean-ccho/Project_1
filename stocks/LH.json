s, and manage their accounts; and Generative AI enabled Test Selection, a generative AI enabled tool. It serves clients, third party, medicare/medicaid, patients, pharmaceutical, biotechnology, medical device, diagnostic companies, and CROs. It has a collaboration with the Children's Hospital of Philadelphia to accelerate the discovery, development, and availability of pediatric diagnostics. The company was founded in 1995 and is headquartered in Burlington, North Carolina.","detail":{"as_of":"2026-11-06","valuation":{"pe":30.05,"fpe":18.71,"peg":1.61,"ps":2.04,"pb":3.36,"ev_ebitda":15.51,"ind":{"pe":36.64,"fpe":26.16,"peg":1.61,"ps":6.32,"pb":5.45,"ev_ebitda":24.84},"n_peers":29,"industry":"Diagnostics & Research"},"analyst":{"n":16,"mean":382.25,"median":384.0,"high":420.0,"low":330.0,"rec_mean":1.71,"rec_key":"buy","rec":{"strong_buy":2,"buy":10,"hold":5,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-02-06","est":3.39,"act":3.45,"surprise":1.71},{"date":"2025-04-29","est":3.73,"act":3.84,"surprise":2.82},{"date":"2025-07-24","est":4.16,"act":4.35,"surprise":4.47},{"date":"2025-10-28","est":4.14,"act":4.18,"surprise":1.01},{"date":"2026-02-17","est":3.94,"act":4.07,"surprise":3.25},{"date":"2026-04-30","est":4.12,"act":4.25,"surprise":3.26},{"date":"2026-07-30","est":4.77,"act":4.99,"surprise":4.65},{"date":"2026-10-28","est":4.64,"act":4.78,"surprise":2.94}],"revenue":[{"end":"2025-09-30","revenue":3563500000.0,"eps_gaap":3.12},{"end":"2025-12-31","revenue":3515800000.0,"eps_gaap":1.98},{"end":"2026-03-31","revenue":3537600000.0,"eps_gaap":3.35},{"end":"2026-06-30","revenue":3731100000.0,"eps_gaap":3.64},{"end":"2026-09-30","revenue":3810000000.0,"eps_gaap":3.22}],"next":{"date":null,"eps_est":4.5146,"eps_year_ago":4.07,"n":12,"rev_est":3755117560.0,"rev_growth":0.0681}}},"congress":[{"filed":"2026-09-09","date":"2026-08-25","lag":15,"member":"April McClain Delaney","party":"D","state":"MD","leader":null,"owner":"child","type":"sell","partial":false,