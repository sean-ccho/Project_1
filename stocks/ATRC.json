ubtle Cannula's to support access for EPi-Sense catheters. In addition, the company sells various reusable cardiac surgery instruments. It markets and sells its products through independent distributors and direct sales personnel. The company was incorporated in 2000 and is headquartered in Mason, Ohio.","detail":{"as_of":"2026-11-06","valuation":{"pe":188.84,"fpe":133.32,"peg":null,"ps":5.05,"pb":5.59,"ev_ebitda":75.68,"ind":{"pe":41.87,"fpe":18.71,"peg":1.31,"ps":2.84,"pb":2.84,"ev_ebitda":15.91},"n_peers":28,"industry":"Medical Instruments & Supplies"},"analyst":{"n":9,"mean":60.44,"median":62.0,"high":68.0,"low":50.0,"rec_mean":null,"rec_key":null,"rec":{"strong_buy":3,"buy":4,"hold":3,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2024-10-29","est":-0.2,"act":-0.17,"surprise":13.44},{"date":"2025-02-12","est":-0.15,"act":-0.08,"surprise":46.22},{"date":"2025-04-29","est":-0.22,"act":-0.14,"surprise":37.32},{"date":"2025-07-29","est":-0.16,"act":-0.02,"surprise":87.71},{"date":"2025-10-29","est":-0.12,"act":-0.01,"surprise":91.49},{"date":"2026-02-17","est":-0.04,"act":0.06,"surprise":249.89},{"date":"2026-07-23","est":0.02,"act":0.18,"surprise":650.31},{"date":"2026-11-03","est":0.01,"act":0.17,"surprise":1326.17}],"revenue":[{"end":"2025-09-30","revenue":134269000.0,"eps_gaap":-0.01},{"end":"2025-12-31","revenue":140500000.0,"eps_gaap":0.04},{"end":"2026-03-31","revenue":141249000.0,"eps_gaap":0.0},{"end":"2026-06-30","revenue":153604000.0,"eps_gaap":0.18},{"end":"2026-09-30","revenue":154450000.0,"eps_gaap":0.08}],"next":{"date":null,"eps_est":0.0827,"eps_year_ago":0.06,"n":9,"rev_est":159411070.0,"rev_growth":0.1346}}},"congress":[{"filed":"2026-10-12","date":"2026-09-29","lag":13,"member":"Gilbert Ray Cisneros, Jr.","party":"D","state":"CA","leader":null,"owner":"self","type":"sell","partial":true,"atype":"ST","low":1001,"high":15000,"amount":"$1,001 - $15,000","url":"https://disclosures-clerk.house.gov/public_disc/ptr-pdfs/2026/20035622.pdf"},{"fil