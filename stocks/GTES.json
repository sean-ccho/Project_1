cluding heavy-duty trucks and buses; energy and resources markets, such as oil, gas, and mining; and personal mobility, including scooters, motorcycles, bicycles, all-terrain vehicles, and snowmobiles. It sells its products under the Gates brand. It offers its products to aftermarket channel customers and original equipment manufacturers. Gates Industrial Corporation Ltd. was formerly known as Gates Industrial Corporation plc and changed its name to Gates Industrial Corporation Ltd. in July 2026. The company was founded in 1911 and is based in Denver, Colorado.","detail":{"as_of":"2026-11-13","valuation":{"pe":17.64,"fpe":13.1,"peg":null,"ps":1.8,"pb":1.79,"ev_ebitda":10.8,"ind":{"pe":29.38,"fpe":19.19,"peg":1.72,"ps":3.26,"pb":3.99,"ev_ebitda":16.24},"n_peers":44,"industry":"Specialty Industrial Machinery"},"analyst":{"n":12,"mean":32.75,"median":33.5,"high":40.0,"low":27.0,"rec_mean":1.83,"rec_key":"buy","rec":{"strong_buy":2,"buy":6,"hold":4,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-02-06","est":0.33,"act":0.36,"surprise":8.68},{"date":"2025-04-30","est":0.33,"act":0.36,"surprise":9.2},{"date":"2025-07-30","est":0.38,"act":0.39,"surprise":2.97},{"date":"2025-10-29","est":0.37,"act":0.39,"surprise":5.44},{"date":"2026-02-12","est":0.37,"act":0.38,"surprise":3.96},{"date":"2026-05-01","est":0.33,"act":0.35,"surprise":6.51},{"date":"2026-07-31","est":0.42,"act":0.44,"surprise":5.82},{"date":"2026-10-30","est":0.44,"act":0.47,"surprise":6.85}],"revenue":[{"end":"2025-09-30","revenue":855700000.0,"eps_gaap":0.31},{"end":"2025-12-31","revenue":856200000.0,"eps_gaap":0.2},{"end":"2026-03-31","revenue":851100000.0,"eps_gaap":0.23},{"end":"2026-06-30","revenue":941600000.0,"eps_gaap":0.67},{"end":"2026-09-30","revenue":903600000.0,"eps_gaap":0.34}],"next":{"date":null,"eps_est":0.4505,"eps_year_ago":0.38,"n":11,"rev_est":915016480.0,"rev_growth":0.0687}}},"congress":[{"filed":"2026-10-12","date":"2026-09-29","lag":13,"member":"Gilbert Ray Cisneros, Jr.",