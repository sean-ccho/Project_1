xterior accessories, mirrors, performance products protectants and cleaners, sealants and adhesives, steering wheel covers, tools, towing, vehicle entertainment systems, and wash and wax. It offers its products under the AutoZone, AutoZone Rewards, Get in the Zone, Zone, Duralast, Econocraft, ProElite, ProVantage, ShopPro, SureBilt, TotalPro, TruGrade, Valucraft, and ALLDATA names. The company sells its products through stores, www.autozone.com, www.autozonepro.com, www.alldata.com, and www.duralastparts.com, as well as commercial sales program that provides delivery of parts and other products and commercial credit to local, regional and national repair garages, dealers, service stations, fleet owners, and other accounts. AutoZone, Inc. was founded in 1979 and is headquartered in Memphis, Tennessee.","detail":{"as_of":"2026-11-06","valuation":{"pe":21.08,"fpe":16.74,"peg":1.41,"ps":2.55,"pb":-20.79,"ev_ebitda":15.09,"ind":{"pe":19.66,"fpe":9.42,"peg":0.56,"ps":0.69,"pb":1.63,"ev_ebitda":7.1},"n_peers":28,"industry":"Auto Parts"},"analyst":{"n":23,"mean":3665.61,"median":3648.0,"high":4450.0,"low":3000.0,"rec_mean":1.48,"rec_key":"strong_buy","rec":{"strong_buy":5,"buy":18,"hold":4,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2024-12-10","est":33.78,"act":32.52,"surprise":-3.73},{"date":"2025-03-04","est":28.97,"act":28.29,"surprise":-2.35},{"date":"2025-05-27","est":37.27,"act":35.36,"surprise":-5.12},{"date":"2025-09-23","est":50.72,"act":48.71,"surprise":-3.97},{"date":"2025-12-09","est":32.58,"act":31.04,"surprise":-4.74},{"date":"2026-03-03","est":27.41,"act":27.63,"surprise":0.81},{"date":"2026-05-26","est":36.17,"act":38.07,"surprise":5.26},{"date":"2026-09-22","est":53.89,"act":56.05,"surprise":4.01}],"revenue":[{"end":"2025-08-31","revenue":6242726000.0,"eps_gaap":48.71},{"end":"2025-11-30","revenue":4628630000.0,"eps_gaap":31.04},{"end":"2026-02-28","revenue":4274098000.0,"eps_gaap":27.63},{"end":"2026-05-31","revenue":4840950000.0,"eps_gaap":38.