ity operations. The company was formerly known as AlliedSignal, Inc. Honeywell International Inc. was founded in 1885 and is headquartered in Charlotte, North Carolina.","detail":{"as_of":"2026-11-06","valuation":{"pe":10.91,"fpe":22.33,"peg":3.0,"ps":1.85,"pb":3.12,"ev_ebitda":9.0,"ind":{"pe":12.98,"fpe":15.37,"peg":1.65,"ps":1.3,"pb":1.72,"ev_ebitda":8.77},"n_peers":9,"industry":"Conglomerates"},"analyst":{"n":23,"mean":253.91,"median":254.0,"high":290.0,"low":186.0,"rec_mean":2.0,"rec_key":"buy","rec":{"strong_buy":3,"buy":11,"hold":9,"sell":0,"strong_sell":1}},"quarters":{"eps":[{"date":"2025-02-06","est":4.69,"act":4.94,"surprise":5.28},{"date":"2025-04-29","est":4.42,"act":5.02,"surprise":13.64},{"date":"2025-07-24","est":5.32,"act":5.5,"surprise":3.43},{"date":"2025-10-23","est":5.13,"act":5.64,"surprise":9.87},{"date":"2026-01-29","est":5.07,"act":5.18,"surprise":2.14},{"date":"2026-04-23","est":4.64,"act":4.9,"surprise":5.55},{"date":"2026-07-23","est":1.82,"act":1.95,"surprise":7.22},{"date":"2026-10-22","est":2.16,"act":2.27,"surprise":4.88}],"revenue":[{"end":"2025-09-30","revenue":4929000000.0,"eps_gaap":5.72},{"end":"2025-12-31","revenue":6860000000.0,"eps_gaap":0.92},{"end":"2026-03-31","revenue":9143000000.0,"eps_gaap":2.58},{"end":"2026-06-30","revenue":9719000000.0,"eps_gaap":17.83},{"end":"2026-09-30","revenue":4994000000.0,"eps_gaap":2.08}],"next":{"date":"2027-01-28","eps_est":2.4529,"eps_year_ago":5.18,"n":17,"rev_est":5158018440.0,"rev_growth":-0.4714}}},"congress":[{"filed":"2026-10-27","date":"2026-10-01","lag":26,"member":"Pete Sessions","party":"R","state":"TX","leader":null,"owner":"self","type":"sell","partial":false,"atype":"ST","low":1001,"high":15000,"amount":"$1,001 - $15,000","url":"https://disclosures-clerk.house.gov/public_disc/ptr-pdfs/2026/20035563.pdf"},{"filed":"2026-10-07","date":"2026-09-24","lag":13,"member":"Maria Elvira Salazar","party":"R","state":"FL","leader":null,"owner":"self","type":"sell","partial":true,"atype":"ST