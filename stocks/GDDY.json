ovider of domain name registry services; and hosting and security services comprising shared website hosting and virtual private servers, as well as security products with a suite of tools designed to help secure customers' online presence; and SSL certificates. The company serves small businesses, individuals, organizations, developers, designers, and domain investors. GoDaddy Inc. was founded in 1997 and is headquartered in Tempe, Arizona.","detail":{"as_of":"2026-11-06","valuation":{"pe":15.73,"fpe":10.18,"peg":0.67,"ps":2.68,"pb":-100.78,"ev_ebitda":11.6,"ind":{"pe":30.01,"fpe":19.06,"peg":1.22,"ps":4.5,"pb":4.8,"ev_ebitda":21.86},"n_peers":76,"industry":"Software - Infrastructure"},"analyst":{"n":16,"mean":117.69,"median":115.0,"high":170.0,"low":76.0,"rec_mean":2.44,"rec_key":"buy","rec":{"strong_buy":2,"buy":5,"hold":10,"sell":1,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-02-13","est":1.44,"act":1.36,"surprise":-5.54},{"date":"2025-05-01","est":1.97,"act":1.86,"surprise":-5.15},{"date":"2025-08-07","est":1.34,"act":1.41,"surprise":5.41},{"date":"2025-10-30","est":2.15,"act":1.99,"surprise":-7.1},{"date":"2026-02-24","est":2.22,"act":2.3,"surprise":3.72},{"date":"2026-04-30","est":1.99,"act":2.05,"surprise":2.69},{"date":"2026-07-30","est":1.69,"act":1.83,"surprise":8.01},{"date":"2026-10-29","est":1.9,"act":2.08,"surprise":9.63}],"revenue":[{"end":"2025-09-30","revenue":1265300000.0,"eps_gaap":1.51},{"end":"2025-12-31","revenue":1273900000.0,"eps_gaap":1.8},{"end":"2026-03-31","revenue":1266900000.0,"eps_gaap":1.6},{"end":"2026-06-30","revenue":1298000000.0,"eps_gaap":1.83},{"end":"2026-09-30","revenue":1341800000.0,"eps_gaap":2.08}],"next":{"date":null,"eps_est":2.0807,"eps_year_ago":1.8,"n":12,"rev_est":1348260050.0,"rev_growth":0.0584}}},"congress":[{"filed":"2026-07-02","date":"2026-06-16","lag":16,"member":"Gilbert Ray Cisneros, Jr.","party":"D","state":"CA","leader":null,"owner":"self","type":"sell","partial":false,"atype":"ST","low":1001,"high":