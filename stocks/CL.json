ort dogs and cats in different stages of health under the Hill's Prescription Diet brand; and a fresh pet food sold to pet specialty and other retailers in Australia under Prime100 brand. This segment markets and sells its products through pet supply retailers, veterinarians, and eCommerce retailers. Colgate-Palmolive Company was founded in 1806 and is headquartered in New York, New York.","detail":{"as_of":"2026-11-06","valuation":{"pe":37.57,"fpe":23.55,"peg":1.81,"ps":3.61,"pb":266.74,"ev_ebitda":16.51,"ind":{"pe":25.82,"fpe":17.06,"peg":2.28,"ps":2.81,"pb":5.69,"ev_ebitda":15.52},"n_peers":13,"industry":"Household & Personal Products"},"analyst":{"n":20,"mean":101.7,"median":102.5,"high":112.0,"low":88.0,"rec_mean":2.1,"rec_key":"buy","rec":{"strong_buy":6,"buy":7,"hold":7,"sell":0,"strong_sell":1}},"quarters":{"eps":[{"date":"2025-01-31","est":0.89,"act":0.91,"surprise":2.32},{"date":"2025-04-25","est":0.86,"act":0.91,"surprise":6.12},{"date":"2025-08-01","est":0.89,"act":0.92,"surprise":2.81},{"date":"2025-10-31","est":0.89,"act":0.91,"surprise":2.36},{"date":"2026-01-30","est":0.91,"act":0.95,"surprise":4.19},{"date":"2026-05-01","est":0.94,"act":0.97,"surprise":2.7},{"date":"2026-07-31","est":0.95,"act":0.99,"surprise":4.53},{"date":"2026-10-30","est":0.93,"act":0.97,"surprise":4.83}],"revenue":[{"end":"2025-09-30","revenue":5131000000.0,"eps_gaap":0.91},{"end":"2025-12-31","revenue":5230000000.0,"eps_gaap":-0.05},{"end":"2026-03-31","revenue":5324000000.0,"eps_gaap":0.8},{"end":"2026-06-30","revenue":5361000000.0,"eps_gaap":0.86},{"end":"2026-09-30","revenue":5369000000.0,"eps_gaap":0.94}],"next":{"date":"2027-01-29","eps_est":0.9796,"eps_year_ago":0.95,"n":17,"rev_est":5362230540.0,"rev_growth":0.0253}}},"congress":[{"filed":"2026-09-25","date":"2026-08-27","lag":29,"member":"Kevin Hern","party":"R","state":"OK","leader":"House Republican Policy Committee Chair","owner":"self","type":"sell","partial":true,"atype":"ST","low":1001,"high":15000,"amount":"$1,0