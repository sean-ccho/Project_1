. Central Garden & Pet Company was founded in 1955 and is headquartered in Walnut Creek, California.","detail":{"as_of":"2026-11-06","valuation":{"pe":15.11,"fpe":13.21,"peg":null,"ps":0.83,"pb":1.46,"ev_ebitda":8.77,"ind":{"pe":15.11,"fpe":11.57,"peg":1.34,"ps":0.85,"pb":1.67,"ev_ebitda":8.8},"n_peers":30,"industry":"Packaged Foods"},"analyst":{"n":4,"mean":46.25,"median":48.0,"high":50.0,"low":39.0,"rec_mean":null,"rec_key":null,"rec":{"strong_buy":1,"buy":3,"hold":0,"sell":0,"strong_sell":1}},"quarters":{"eps":[{"date":"2024-11-25","est":-0.22,"act":-0.19,"surprise":14.34},{"date":"2025-02-05","est":-0.04,"act":0.21,"surprise":673.3},{"date":"2025-05-07","est":0.93,"act":1.04,"surprise":11.6},{"date":"2025-08-06","est":1.43,"act":1.56,"surprise":9.35},{"date":"2025-11-24","est":-0.2,"act":-0.09,"surprise":54.28},{"date":"2026-02-04","est":0.14,"act":0.21,"surprise":51.8},{"date":"2026-05-06","est":1.1,"act":1.29,"surprise":17.28},{"date":"2026-08-05","est":1.53,"act":1.54,"surprise":0.55}],"revenue":[{"end":"2025-06-30","revenue":960913000.0,"eps_gaap":1.52},{"end":"2025-09-30","revenue":678178000.0,"eps_gaap":-0.16},{"end":"2025-12-31","revenue":617373000.0,"eps_gaap":0.11},{"end":"2026-03-31","revenue":906152000.0,"eps_gaap":1.28},{"end":"2026-06-30","revenue":882362000.0,"eps_gaap":1.45}],"next":{"date":"2026-11-25","eps_est":-0.0585,"eps_year_ago":-0.09,"n":5,"rev_est":607300000.0,"rev_growth":-0.1045}}},"congress":[{"filed":"2026-04-07","date":"2026-03-03","lag":35,"member":"Gilbert Ray Cisneros, Jr.","party":"D","state":"CA","leader":null,"owner":"self","type":"buy","partial":false,"atype":"ST","low":1001,"high":15000,"amount":"$1,001 - $15,000","url":"https://disclosures-clerk.house.gov/public_disc/ptr-pdfs/2026/20034285.pdf"}]}