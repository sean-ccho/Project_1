ervices; managed CDN; and support plans services. It serves customers operating in ecommerce, streaming media, gaming, digital publishing, and high tech to financial services industries. The company was formerly known as SkyCache, Inc. and changed its name to Fastly, Inc. in May 2012. Fastly, Inc. was incorporated in 2011 and is headquartered in San Francisco, California.","detail":{"as_of":"2026-11-13","valuation":{"pe":null,"fpe":23.16,"peg":0.13,"ps":3.73,"pb":2.67,"ev_ebitda":-114.61,"ind":{"pe":33.02,"fpe":19.54,"peg":1.08,"ps":4.58,"pb":5.7,"ev_ebitda":22.34},"n_peers":98,"industry":"Software - Application"},"analyst":{"n":11,"mean":24.73,"median":24.0,"high":35.0,"low":17.0,"rec_mean":2.17,"rec_key":"buy","rec":{"strong_buy":1,"buy":5,"hold":5,"sell":0,"strong_sell":1}},"quarters":{"eps":[{"date":"2025-02-12","est":null,"act":-0.03,"surprise":-615.99},{"date":"2025-05-07","est":-0.06,"act":-0.05,"surprise":19.64},{"date":"2025-08-06","est":-0.05,"act":-0.03,"surprise":42.75},{"date":"2025-11-05","est":null,"act":0.07,"surprise":41076.47},{"date":"2026-02-11","est":0.06,"act":0.12,"surprise":109.21},{"date":"2026-05-06","est":0.09,"act":0.13,"surprise":50.22},{"date":"2026-08-05","est":0.07,"act":0.15,"surprise":126.31},{"date":"2026-11-04","est":0.12,"act":0.17,"surprise":43.39}],"revenue":[{"end":"2025-09-30","revenue":158223000.0,"eps_gaap":-0.2},{"end":"2025-12-31","revenue":172612000.0,"eps_gaap":-0.1},{"end":"2026-03-31","revenue":173021000.0,"eps_gaap":-0.13},{"end":"2026-06-30","revenue":183317000.0,"eps_gaap":-0.1},{"end":"2026-09-30","revenue":190193000.0,"eps_gaap":-0.07}],"next":{"date":null,"eps_est":0.1726,"eps_year_ago":0.12,"n":12,"rev_est":200653350.0,"rev_growth":0.1625}}}}