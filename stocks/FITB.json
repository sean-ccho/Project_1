nd home improvement and solar energy installation loans through contractors and installers. The Wealth and Asset Management segment provides various wealth management services, such as wealth planning, investment management, banking, insurance, trust, and estate services for individuals, companies, and not-for-profit organizations; retail brokerage services for individual clients; and advisory services for institutional clients. Fifth Third Bancorp was founded in 1858 and is headquartered in Cincinnati, Ohio.","detail":{"as_of":"2026-11-06","valuation":{"pe":17.8,"fpe":10.68,"peg":1.7,"ps":4.3,"pb":1.55,"ev_ebitda":null,"ind":{"pe":11.93,"fpe":10.2,"peg":1.4,"ps":3.62,"pb":1.28,"ev_ebitda":null},"n_peers":156,"industry":"Banks - Regional"},"analyst":{"n":21,"mean":61.54,"median":61.0,"high":67.0,"low":55.0,"rec_mean":1.55,"rec_key":"buy","rec":{"strong_buy":4,"buy":14,"hold":4,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-01-21","est":0.87,"act":0.9,"surprise":3.01},{"date":"2025-04-17","est":0.7,"act":0.71,"surprise":1.42},{"date":"2025-07-17","est":0.87,"act":0.88,"surprise":1.47},{"date":"2025-10-17","est":0.86,"act":0.91,"surprise":5.86},{"date":"2026-01-20","est":0.99,"act":1.04,"surprise":4.93},{"date":"2026-04-17","est":0.22,"act":0.15,"surprise":-32.16},{"date":"2026-07-17","est":0.84,"act":0.83,"surprise":-1.24},{"date":"2026-10-19","est":0.82,"act":0.9,"surprise":9.7}],"revenue":[{"end":"2025-06-30","revenue":2223000000.0,"eps_gaap":null},{"end":"2025-09-30","revenue":2279000000.0,"eps_gaap":0.91},{"end":"2025-12-31","revenue":2209000000.0,"eps_gaap":1.04},{"end":"2026-03-31","revenue":2795000000.0,"eps_gaap":0.15},{"end":"2026-06-30","revenue":3209000000.0,"eps_gaap":0.83}],"next":{"date":"2027-01-19","eps_est":1.1054,"eps_year_ago":1.04,"n":15,"rev_est":3427093040.0,"rev_growth":0.4621}}},"congress":[{"filed":"2026-10-15","date":"2026-10-09","lag":6,"member":"David J. Taylor","party":"R","state":"OH","leader":null,"owner":"self","type":"buy