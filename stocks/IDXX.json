nnect PLUS, a cloud-based technology that enables veterinarians to access and analyze patients, as well as operates VetLab Station. It markets its products through marketing, customer service, sales, and technical service groups, as well as through independent distributors and other resellers. IDEXX Laboratories, Inc. was incorporated in 1983 and is headquartered in Westbrook, Maine.","detail":{"as_of":"2026-11-06","valuation":{"pe":45.56,"fpe":40.04,"peg":3.12,"ps":11.42,"pb":28.5,"ev_ebitda":32.3,"ind":{"pe":36.64,"fpe":26.16,"peg":1.61,"ps":6.32,"pb":5.45,"ev_ebitda":24.84},"n_peers":29,"industry":"Diagnostics & Research"},"analyst":{"n":12,"mean":708.83,"median":707.5,"high":810.0,"low":470.0,"rec_mean":2.14,"rec_key":"buy","rec":{"strong_buy":4,"buy":5,"hold":4,"sell":1,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-02-03","est":2.4,"act":2.62,"surprise":9.21},{"date":"2025-05-01","est":2.84,"act":2.96,"surprise":4.07},{"date":"2025-08-04","est":3.3,"act":3.63,"surprise":9.97},{"date":"2025-11-03","est":3.15,"act":3.4,"surprise":8.08},{"date":"2026-02-02","est":2.94,"act":3.08,"surprise":4.81},{"date":"2026-05-05","est":3.41,"act":3.47,"surprise":1.74},{"date":"2026-08-04","est":3.93,"act":4.27,"surprise":8.54},{"date":"2026-11-02","est":3.71,"act":4.01,"surprise":7.98}],"revenue":[{"end":"2025-09-30","revenue":1105239000.0,"eps_gaap":3.4},{"end":"2025-12-31","revenue":1090579000.0,"eps_gaap":3.08},{"end":"2026-03-31","revenue":1140820000.0,"eps_gaap":3.47},{"end":"2026-06-30","revenue":1216585000.0,"eps_gaap":4.27},{"end":"2026-09-30","revenue":1214237000.0,"eps_gaap":4.01}],"next":{"date":"2027-02-01","eps_est":3.7136,"eps_year_ago":3.08,"n":10,"rev_est":1183437690.0,"rev_growth":0.0851}}},"congress":[{"filed":"2026-02-02","date":"2026-01-13","lag":20,"member":"April McClain Delaney","party":"D","state":"MD","leader":null,"owner":"child","type":"sell","partial":false,"atype":"ST","low":1001,"high":15000,"amount":"$1,001 - $15,000","url":"https://disclosur