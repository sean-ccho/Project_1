ation systems; strategic, advanced strike, and defensive systems; and classified systems and services in support of national security systems. This segment also provides network-enabled situational awareness; and integrates space and ground global systems to help its customers gather, analyze, and securely distribute critical intelligence data. It primarily serves the U.S. government and international customers, as well as foreign military sales contracted through the U.S. government. The company was formerly known as The Lockheed Corporation and changed its name to Lockheed Martin Corporation in March 1995. Lockheed Martin Corporation was founded in 1912 and is based in Bethesda, Maryland.","detail":{"as_of":"2026-11-13","valuation":{"pe":21.17,"fpe":17.9,"peg":1.11,"ps":1.74,"pb":13.62,"ev_ebitda":15.63,"ind":{"pe":35.55,"fpe":25.57,"peg":1.11,"ps":3.15,"pb":4.29,"ev_ebitda":18.98},"n_peers":48,"industry":"Aerospace & Defense"},"analyst":{"n":22,"mean":660.86,"median":661.5,"high":835.0,"low":498.0,"rec_mean":2.21,"rec_key":"buy","rec":{"strong_buy":2,"buy":8,"hold":12,"sell":1,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-01-28","est":6.6,"act":2.22,"surprise":-66.39},{"date":"2025-04-22","est":6.35,"act":7.28,"surprise":14.69},{"date":"2025-07-22","est":6.42,"act":1.46,"surprise":-77.27},{"date":"2025-10-21","est":6.36,"act":6.95,"surprise":9.31},{"date":"2026-01-29","est":5.75,"act":5.8,"surprise":0.94},{"date":"2026-04-23","est":6.69,"act":6.44,"surprise":-3.78},{"date":"2026-07-23","est":7.19,"act":7.94,"surprise":10.39},{"date":"2026-10-22","est":7.52,"act":7.97,"surprise":6.01}],"revenue":[{"end":"2025-09-30","revenue":18609000000.0,"eps_gaap":6.95},{"end":"2025-12-31","revenue":20321000000.0,"eps_gaap":5.8},{"end":"2026-03-31","revenue":18021000000.0,"eps_gaap":6.44},{"end":"2026-06-30","revenue":20063000000.0,"eps_gaap":7.94},{"end":"2026-09-30","revenue":20711000000.0,"eps_gaap":7.97}],"next":{"date":"2027-01-26","eps_est":8.2069,"eps_year_ago":5.8,