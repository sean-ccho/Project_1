ruction; and original equipment manufacturers in agriculture, control, appliance, medical, energy and charging infrastructure, data/telecom, and aerospace and defense industries, as well as systems integrators, aerospace, and motor and compressor distributors. Sensata Technologies Holding plc was founded in 1916 and is headquartered in Attleboro, Massachusetts.","detail":{"as_of":"2026-11-13","valuation":{"pe":15.42,"fpe":9.52,"peg":0.21,"ps":1.46,"pb":1.83,"ev_ebitda":9.32,"ind":{"pe":32.19,"fpe":20.9,"peg":0.87,"ps":4.57,"pb":3.75,"ev_ebitda":19.43},"n_peers":14,"industry":"Scientific & Technical Instruments"},"analyst":{"n":11,"mean":51.64,"median":51.0,"high":63.0,"low":40.0,"rec_mean":2.08,"rec_key":"buy","rec":null},"quarters":{"eps":[{"date":"2025-02-11","est":0.75,"act":0.76,"surprise":1.43},{"date":"2025-05-08","est":0.72,"act":0.78,"surprise":8.32},{"date":"2025-07-29","est":0.84,"act":0.87,"surprise":4.0},{"date":"2025-10-28","est":0.85,"act":0.89,"surprise":4.61},{"date":"2026-02-19","est":0.86,"act":0.88,"surprise":2.08},{"date":"2026-04-28","est":0.84,"act":0.86,"surprise":2.79},{"date":"2026-07-29","est":0.93,"act":0.98,"surprise":4.92},{"date":"2026-10-27","est":0.96,"act":1.13,"surprise":18.15}],"revenue":[{"end":"2025-09-30","revenue":932000000.0,"eps_gaap":-1.12},{"end":"2025-12-31","revenue":917883000.0,"eps_gaap":0.43},{"end":"2026-03-31","revenue":934800000.0,"eps_gaap":0.59},{"end":"2026-06-30","revenue":990600000.0,"eps_gaap":0.7},{"end":"2026-09-30","revenue":1003600000.0,"eps_gaap":0.78}],"next":{"date":null}}},"congress":[{"filed":"2026-06-08","date":"2026-05-07","lag":32,"member":"Gilbert Ray Cisneros, Jr.","party":"D","state":"CA","leader":null,"owner":"self","type":"buy","partial":false,"atype":"ST","low":1001,"high":15000,"amount":"$1,001 - $15,000","url":"https://disclosures-clerk.house.gov/public_disc/ptr-pdfs/2026/20034713.pdf"},{"filed":"2026-06-08","date":"2026-05-11","lag":28,"member":"Gilbert Ray Cisneros, Jr.","party":"D","stat