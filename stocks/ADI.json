t systems, as well as isolators. In addition, the company provides digital signal processing and system products for numeric calculations. It serves clients in the industrial, automotive, consumer, instrumentation, aerospace, defense and healthcare, and communications markets through a direct sales force, third-party distributors, and independent sales representatives, as well as online. The company was incorporated in 1965 and is headquartered in Wilmington, Massachusetts.","detail":{"as_of":"2026-11-27","valuation":{"pe":33.89,"fpe":17.43,"peg":0.51,"ps":11.0,"pb":4.93,"ev_ebitda":22.05,"ind":{"pe":40.44,"fpe":17.43,"peg":0.47,"ps":6.46,"pb":5.29,"ev_ebitda":22.51},"n_peers":42,"industry":"Semiconductors"},"analyst":{"n":32,"mean":441.34,"median":437.5,"high":575.0,"low":323.0,"rec_mean":1.37,"rec_key":"strong_buy","rec":null},"quarters":{"eps":[{"date":"2025-02-19","est":1.54,"act":1.63,"surprise":5.6},{"date":"2025-05-22","est":1.7,"act":1.85,"surprise":9.14},{"date":"2025-08-20","est":1.95,"act":2.05,"surprise":5.33},{"date":"2025-11-25","est":2.23,"act":2.26,"surprise":1.13},{"date":"2026-02-18","est":2.31,"act":2.46,"surprise":6.55},{"date":"2026-05-20","est":2.91,"act":3.09,"surprise":6.22},{"date":"2026-08-19","est":3.34,"act":3.45,"surprise":3.32},{"date":"2026-11-24","est":3.88,"act":4.06,"surprise":4.56}],"revenue":[{"end":"2025-07-31","revenue":2880348000.0,"eps_gaap":1.04},{"end":"2025-10-31","revenue":3076117000.0,"eps_gaap":1.6},{"end":"2026-01-31","revenue":3160263000.0,"eps_gaap":1.69},{"end":"2026-04-30","revenue":3623465000.0,"eps_gaap":2.4},{"end":"2026-07-31","revenue":4021899000.0,"eps_gaap":2.74}],"next":{"date":"2027-02-17"}}},"splits":[["1980-04-16",1.25],["1981-04-07",1.25],["1982-04-13",1.25],["1983-04-05",1.5],["1984-04-17",1.333333],["1986-04-15",1.333333],["1995-01-05",1.5],["1996-01-04",1.5],["1997-01-07",1.333333],["2000-03-16",2.0]],"congress":[{"filed":"2026-11-23","date":"2026-04-29","lag":208,"member":"Harriet M. Hageman","party"