vernment, public safety, and commercial communications networks. It serves hospitality; manufacturing; military and defence; police; air transportation; fire and rescue; stadium; emergency medical services; mining; oil and gas; transportation and logistics; utilities; education; retail; and healthcare industries. The company was formerly known as Motorola, Inc. and changed its name to Motorola Solutions, Inc. in January 2011. Motorola Solutions, Inc. was founded in 1928 and is headquartered in Chicago, Illinois.","detail":{"as_of":"2026-11-13","valuation":{"pe":42.74,"fpe":27.17,"peg":2.32,"ps":6.97,"pb":28.65,"ev_ebitda":26.64,"ind":{"pe":37.82,"fpe":16.11,"peg":0.62,"ps":5.21,"pb":3.0,"ev_ebitda":22.02},"n_peers":19,"industry":"Communication Equipment"},"analyst":{"n":11,"mean":547.18,"median":550.0,"high":598.0,"low":476.0,"rec_mean":1.64,"rec_key":"buy","rec":{"strong_buy":5,"buy":7,"hold":2,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-02-13","est":3.89,"act":4.04,"surprise":3.94},{"date":"2025-05-01","est":3.01,"act":3.18,"surprise":5.66},{"date":"2025-08-07","est":3.36,"act":3.57,"surprise":6.21},{"date":"2025-10-30","est":3.85,"act":4.06,"surprise":5.45},{"date":"2026-02-11","est":4.35,"act":4.59,"surprise":5.44},{"date":"2026-05-07","est":3.25,"act":3.37,"surprise":3.83},{"date":"2026-08-05","est":3.85,"act":4.41,"surprise":14.45},{"date":"2026-11-04","est":4.43,"act":4.69,"surprise":5.75}],"revenue":[{"end":"2025-09-30","revenue":3009000000.0,"eps_gaap":3.33},{"end":"2025-12-31","revenue":3380000000.0,"eps_gaap":3.86},{"end":"2026-03-31","revenue":2714000000.0,"eps_gaap":2.18},{"end":"2026-06-30","revenue":3133000000.0,"eps_gaap":3.33},{"end":"2026-09-30","revenue":3376000000.0,"eps_gaap":3.06}],"next":{"date":null,"eps_est":5.4991,"eps_year_ago":4.59,"n":10,"rev_est":3824735670.0,"rev_growth":0.1316}}},"congress":[{"filed":"2026-04-30","date":"2026-03-23","lag":38,"member":"Jared Moskowitz","party":"D","state":"FL","leader":null,"owner":"chi