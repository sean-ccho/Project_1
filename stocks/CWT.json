 its residential customers. In addition, it provides wastewater collection and treatment services. California Water Service Group was founded in 1926 and is headquartered in San Jose, California.","detail":{"as_of":"2026-11-06","valuation":{"pe":22.58,"fpe":18.73,"peg":2.22,"ps":2.98,"pb":1.69,"ev_ebitda":12.75,"ind":{"pe":22.73,"fpe":20.57,"peg":2.7,"ps":5.01,"pb":2.0,"ev_ebitda":15.58},"n_peers":7,"industry":"Utilities - Regulated Water"},"analyst":{"n":4,"mean":54.75,"median":54.5,"high":57.0,"low":53.0,"rec_mean":1.0,"rec_key":"strong_buy","rec":{"strong_buy":0,"buy":4,"hold":0,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-02-27","est":0.16,"act":0.33,"surprise":102.04},{"date":"2025-05-01","est":0.16,"act":0.22,"surprise":37.5},{"date":"2025-07-31","est":0.56,"act":0.71,"surprise":26.79},{"date":"2025-10-30","est":0.94,"act":1.03,"surprise":9.96},{"date":"2026-02-25","est":0.33,"act":0.19,"surprise":-42.42},{"date":"2026-04-29","est":0.24,"act":0.07,"surprise":-70.21},{"date":"2026-07-29","est":0.63,"act":0.93,"surprise":47.62},{"date":"2026-10-28","est":1.21,"act":1.05,"surprise":-13.22}],"revenue":[{"end":"2025-09-30","revenue":311235000.0,"eps_gaap":1.03},{"end":"2025-12-31","revenue":219978000.0,"eps_gaap":0.19},{"end":"2026-03-31","revenue":214573000.0,"eps_gaap":0.07},{"end":"2026-06-30","revenue":308596000.0,"eps_gaap":0.93},{"end":"2026-09-30","revenue":332168000.0,"eps_gaap":1.05}],"next":{"date":null,"eps_est":0.57,"eps_year_ago":0.19,"n":1,"rev_est":253350630.0,"rev_growth":0.1517}}}}