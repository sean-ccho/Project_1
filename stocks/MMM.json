n and construction; electronics; energy; government; manufacturing; safety; transportation industries. The company offers its products through e-commerce and traditional wholesalers, retailers, jobbers, distributors, channel partner, and dealers, as well as directly to users. 3M Company was founded in 1902 and is headquartered in Saint Paul, Minnesota.","detail":{"as_of":"2026-11-13","valuation":{"pe":27.41,"fpe":18.51,"peg":1.62,"ps":3.76,"pb":22.99,"ev_ebitda":16.23,"ind":{"pe":13.3,"fpe":15.34,"peg":1.62,"ps":1.34,"pb":1.67,"ev_ebitda":8.74},"n_peers":9,"industry":"Conglomerates"},"analyst":{"n":17,"mean":193.43,"median":197.0,"high":230.0,"low":125.0,"rec_mean":2.32,"rec_key":"buy","rec":{"strong_buy":1,"buy":8,"hold":8,"sell":0,"strong_sell":2}},"quarters":{"eps":[{"date":"2025-01-21","est":1.54,"act":1.68,"surprise":9.32},{"date":"2025-04-22","est":1.77,"act":1.88,"surprise":6.42},{"date":"2025-07-18","est":2.01,"act":2.16,"surprise":7.37},{"date":"2025-10-21","est":2.07,"act":2.19,"surprise":5.6},{"date":"2026-01-20","est":1.8,"act":1.83,"surprise":1.79},{"date":"2026-04-21","est":1.98,"act":2.14,"surprise":7.88},{"date":"2026-07-21","est":2.25,"act":2.4,"surprise":6.84},{"date":"2026-10-20","est":2.38,"act":2.46,"surprise":3.21}],"revenue":[{"end":"2025-09-30","revenue":6517000000.0,"eps_gaap":1.55},{"end":"2025-12-31","revenue":6133000000.0,"eps_gaap":1.07},{"end":"2026-03-31","revenue":6030000000.0,"eps_gaap":1.23},{"end":"2026-06-30","revenue":6500000000.0,"eps_gaap":1.78},{"end":"2026-09-30","revenue":6584000000.0,"eps_gaap":2.63}],"next":{"date":"2027-01-19","eps_est":2.0284,"eps_year_ago":1.83,"n":13,"rev_est":6349149610.0,"rev_growth":0.0542}}},"congress":[{"filed":"2026-08-05","date":"2025-03-15","lag":508,"member":"Julie Johnson","party":"D","state":"TX","leader":null,"owner":"self","type":"buy","partial":false,"atype":"ST","low":1001,"high":15000,"amount":"$1,001 - $15,000","url":"https://disclosures-clerk.house.gov/public_disc/ptr-pdfs/2026/200350