 productivity under the Greenlee, Klauke, ProTeam, and RIDGID brands. The Control Systems & Software segment provides control systems and software that control plant processes by collecting and analyzing information from measurement devices in the plant under the DeltaV and Ovation brands. The Test & Measurement offers software-connected automated test and measurement systems. The company was incorporated in 1890 and is headquartered in Saint Louis, Missouri.","detail":{"as_of":"2026-11-06","valuation":{"pe":33.89,"fpe":20.23,"peg":1.9,"ps":4.79,"pb":4.38,"ev_ebitda":18.45,"ind":{"pe":29.54,"fpe":18.2,"peg":1.65,"ps":3.16,"pb":3.88,"ev_ebitda":15.73},"n_peers":44,"industry":"Specialty Industrial Machinery"},"analyst":{"n":28,"mean":177.21,"median":180.0,"high":208.0,"low":104.0,"rec_mean":1.93,"rec_key":"buy","rec":{"strong_buy":4,"buy":16,"hold":8,"sell":2,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-02-05","est":1.28,"act":1.38,"surprise":8.03},{"date":"2025-05-07","est":1.41,"act":1.48,"surprise":4.6},{"date":"2025-08-06","est":1.51,"act":1.52,"surprise":0.69},{"date":"2025-11-05","est":1.62,"act":1.62,"surprise":0.28},{"date":"2026-02-03","est":1.41,"act":1.46,"surprise":3.39},{"date":"2026-05-05","est":1.53,"act":1.54,"surprise":0.44},{"date":"2026-08-04","est":1.68,"act":1.71,"surprise":1.96},{"date":"2026-11-04","est":1.85,"act":1.86,"surprise":0.48}],"revenue":[{"end":"2025-03-31","revenue":4432000000.0,"eps_gaap":null},{"end":"2025-06-30","revenue":4553000000.0,"eps_gaap":null},{"end":"2025-09-30","revenue":4855000000.0,"eps_gaap":1.12},{"end":"2025-12-31","revenue":4346000000.0,"eps_gaap":1.07},{"end":"2026-03-31","revenue":4562000000.0,"eps_gaap":1.1}],"next":{"date":"2027-02-02","eps_est":1.5897,"eps_year_ago":1.46,"n":12,"rev_est":4575344320.0,"rev_growth":0.0528}}},"congress":[{"filed":"2026-10-13","date":"2026-09-17","lag":26,"member":"Kevin Hern","party":"R","state":"OK","leader":"House Republican Policy Committee Chair","owner":"joint","type":