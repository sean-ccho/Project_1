ity management, and configuration control capabilities to protect OT environments, including industrial networks. In addition, it offers Nessus, a vulnerability assessment solution for cybersecurity industry and enterprise platform; and Nessus Expert, which enables users to programmatically detect cloud infrastructure misconfigurations and vulnerabilities in the design and build phase of the software development lifecycle. Tenable Holdings, Inc. was founded in 2002 and is headquartered in Columbia, Maryland.","detail":{"as_of":"2026-11-27","valuation":{"pe":363.15,"fpe":19.17,"peg":1.73,"ps":4.62,"pb":-187.34,"ev_ebitda":94.08,"ind":{"pe":28.92,"fpe":18.18,"peg":1.18,"ps":4.65,"pb":5.24,"ev_ebitda":20.73},"n_peers":76,"industry":"Software - Infrastructure"},"analyst":{"n":20,"mean":48.35,"median":48.0,"high":60.0,"low":35.0,"rec_mean":2.57,"rec_key":"hold","rec":null},"quarters":{"eps":[{"date":"2025-02-05","est":0.34,"act":0.41,"surprise":18.96},{"date":"2025-04-29","est":0.28,"act":0.36,"surprise":27.47},{"date":"2025-07-30","est":0.3,"act":0.34,"surprise":12.33},{"date":"2025-10-29","est":0.37,"act":0.42,"surprise":13.43},{"date":"2026-02-04","est":0.41,"act":0.48,"surprise":15.94},{"date":"2026-04-29","est":0.41,"act":0.47,"surprise":15.03},{"date":"2026-07-29","est":0.47,"act":0.51,"surprise":8.62},{"date":"2026-10-28","est":0.51,"act":0.63,"surprise":24.07}],"revenue":[{"end":"2025-09-30","revenue":252440000.0,"eps_gaap":0.02},{"end":"2025-12-31","revenue":260533000.0,"eps_gaap":-0.01},{"end":"2026-03-31","revenue":262058000.0,"eps_gaap":0.01},{"end":"2026-06-30","revenue":268508000.0,"eps_gaap":0.03},{"end":"2026-09-30","revenue":276387000.0,"eps_gaap":0.1}],"next":{"date":"2027-02-03"}}}}