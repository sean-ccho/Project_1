nt firms, commodity trading firms, and end users. BGC Group, Inc. was founded in 1945 and is headquartered in New York, New York.","detail":{"as_of":"2026-11-06","valuation":{"pe":21.39,"fpe":6.55,"peg":null,"ps":1.55,"pb":5.09,"ev_ebitda":null,"ind":{"pe":15.64,"fpe":13.27,"peg":1.16,"ps":3.47,"pb":2.94,"ev_ebitda":11.69},"n_peers":39,"industry":"Capital Markets"},"analyst":{"n":2,"mean":16.0,"median":16.0,"high":16.0,"low":16.0,"rec_mean":null,"rec_key":null,"rec":{"strong_buy":1,"buy":1,"hold":0,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-02-14","est":0.25,"act":0.25,"surprise":null},{"date":"2025-05-07","est":0.28,"act":0.29,"surprise":1.75},{"date":"2025-07-31","est":0.31,"act":0.31,"surprise":null},{"date":"2025-11-06","est":0.28,"act":0.29,"surprise":3.57},{"date":"2026-02-12","est":0.29,"act":0.31,"surprise":6.9},{"date":"2026-05-07","est":0.41,"act":0.41,"surprise":1.23},{"date":"2026-07-30","est":0.34,"act":0.35,"surprise":4.48},{"date":"2026-11-05","est":0.34,"act":0.34,"surprise":1.49}],"revenue":[{"end":"2025-06-30","revenue":768736000.0,"eps_gaap":0.11},{"end":"2025-09-30","revenue":722810000.0,"eps_gaap":0.06},{"end":"2025-12-31","revenue":743478000.0,"eps_gaap":null},{"end":"2026-03-31","revenue":944902000.0,"eps_gaap":0.17},{"end":"2026-06-30","revenue":818832000.0,"eps_gaap":0.15}],"next":{"date":null,"eps_est":0.34,"eps_year_ago":0.31,"n":2,"rev_est":831184540.0,"rev_growth":0.0989}}}}