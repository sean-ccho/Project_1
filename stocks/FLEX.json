d its name to Flex Ltd. in September 2016. Flex Ltd. was founded in 1969 and is headquartered in Austin, Texas.","detail":{"as_of":"2026-11-13","valuation":{"pe":26.97,"fpe":9.75,"peg":null,"ps":0.89,"pb":4.77,"ev_ebitda":14.45,"ind":{"pe":31.82,"fpe":18.2,"peg":1.14,"ps":2.81,"pb":3.96,"ev_ebitda":15.63},"n_peers":24,"industry":"Electronic Components"},"analyst":{"n":10,"mean":151.4,"median":155.0,"high":176.0,"low":128.0,"rec_mean":1.27,"rec_key":"strong_buy","rec":{"strong_buy":3,"buy":8,"hold":0,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-01-29","est":0.63,"act":0.77,"surprise":21.82},{"date":"2025-05-07","est":0.69,"act":0.73,"surprise":5.23},{"date":"2025-07-24","est":0.64,"act":0.72,"surprise":12.34},{"date":"2025-10-29","est":0.76,"act":0.79,"surprise":4.35},{"date":"2026-02-04","est":0.79,"act":0.87,"surprise":10.54},{"date":"2026-05-05","est":0.88,"act":0.93,"surprise":6.07},{"date":"2026-07-29","est":0.92,"act":1.0,"surprise":8.9},{"date":"2026-10-28","est":1.06,"act":1.18,"surprise":11.5}],"revenue":[{"end":"2025-06-30","revenue":6575000000.0,"eps_gaap":null},{"end":"2025-09-30","revenue":6804000000.0,"eps_gaap":0.52},{"end":"2025-12-31","revenue":7058000000.0,"eps_gaap":0.64},{"end":"2026-03-31","revenue":7477000000.0,"eps_gaap":0.67},{"end":"2026-09-30","revenue":8491000000.0,"eps_gaap":0.7}],"next":{"date":"2027-01-27","eps_est":1.2541,"eps_year_ago":0.87,"n":9,"rev_est":9084421480.0,"rev_growth":0.2871}}},"congress":[{"filed":"2026-06-08","date":"2026-05-11","lag":28,"member":"Gilbert Ray Cisneros, Jr.","party":"D","state":"CA","leader":null,"owner":"self","type":"sell","partial":true,"atype":"ST","low":50001,"high":100000,"amount":"$50,001 - $100,000","url":"https://disclosures-clerk.house.gov/public_disc/ptr-pdfs/2026/20034713.pdf"},{"filed":"2026-06-08","date":"2026-05-07","lag":32,"member":"Gilbert Ray Cisneros, Jr.","party":"D","state":"CA","leader":null,"owner":"self","type":"sell","partial":true,"atype":"ST","low":15001,"high":