ional and business services, financial services, healthcare, manufacturing, media, education, government, technology, media, retail, and hospitality industries. It sells its solutions through its direct sales organization. The company was formerly known as North Tahoe Power Tools, Inc. and changed its name to Workday, Inc. in July 2005. Workday, Inc. was incorporated in 2005 and is headquartered in Pleasanton, California.","detail":{"as_of":"2026-11-06","valuation":{"pe":39.29,"fpe":14.57,"peg":0.6,"ps":4.58,"pb":7.2,"ev_ebitda":29.55,"ind":{"pe":33.22,"fpe":18.43,"peg":1.13,"ps":4.47,"pb":5.8,"ev_ebitda":22.01},"n_peers":99,"industry":"Software - Application"},"analyst":{"n":37,"mean":209.25,"median":210.0,"high":275.0,"low":92.0,"rec_mean":2.31,"rec_key":"buy","rec":{"strong_buy":5,"buy":14,"hold":20,"sell":1,"strong_sell":2}},"quarters":{"eps":[{"date":"2024-11-26","est":1.76,"act":1.89,"surprise":7.49},{"date":"2025-02-25","est":1.78,"act":1.92,"surprise":8.06},{"date":"2025-05-22","est":2.01,"act":2.23,"surprise":10.99},{"date":"2025-08-21","est":2.12,"act":2.21,"surprise":4.44},{"date":"2025-11-25","est":2.17,"act":2.32,"surprise":6.74},{"date":"2026-02-24","est":2.32,"act":2.47,"surprise":6.41},{"date":"2026-05-21","est":2.52,"act":2.66,"surprise":5.68},{"date":"2026-08-27","est":2.61,"act":2.75,"surprise":5.27}],"revenue":[{"end":"2025-07-31","revenue":2348000000.0,"eps_gaap":0.84},{"end":"2025-10-31","revenue":2432000000.0,"eps_gaap":0.94},{"end":"2026-01-31","revenue":2532000000.0,"eps_gaap":0.55},{"end":"2026-04-30","revenue":2542000000.0,"eps_gaap":0.87},{"end":"2026-07-31","revenue":2649000000.0,"eps_gaap":2.57}],"next":{"date":"2026-11-24","eps_est":2.7449,"eps_year_ago":2.32,"n":36,"rev_est":2691535090.0,"rev_growth":0.1067}}},"congress":[{"filed":"2026-09-10","date":"2026-08-18","lag":23,"member":"Gilbert Ray Cisneros, Jr.","party":"D","state":"CA","leader":null,"owner":"self","type":"buy","partial":false,"atype":"ST","low":1001,"high":15000,"amount"