plication protection, and code security. Further, it provides AI-driven security operation solutions, which include a suite of cybersecurity solutions, as well as FortiEDR, FortiXDR, FortiNDR, FortiSandbox, FortiDeceptor, FortiDLP, and FortiRecon. Additionally, the company offers FortiGuard Labs, a cybersecurity threat intelligence and research organization; FortiGuard and Other Security Services, a suite of AI-powered security capabilities that consists of FortiGuard application, content, device, NOC/SOC, and web security services; and FortiCare technical support services. Fortinet, Inc. was incorporated in 2000 and is headquartered in Sunnyvale, California.","detail":{"as_of":"2026-11-13","valuation":{"pe":41.58,"fpe":32.61,"peg":1.51,"ps":11.86,"pb":41.59,"ev_ebitda":33.02,"ind":{"pe":28.08,"fpe":19.3,"peg":1.27,"ps":4.83,"pb":5.23,"ev_ebitda":21.69},"n_peers":75,"industry":"Software - Infrastructure"},"analyst":{"n":37,"mean":145.03,"median":140.0,"high":190.0,"low":110.0,"rec_mean":2.88,"rec_key":"hold","rec":{"strong_buy":2,"buy":6,"hold":30,"sell":4,"strong_sell":1}},"quarters":{"eps":[{"date":"2025-02-06","est":0.61,"act":0.74,"surprise":21.86},{"date":"2025-05-07","est":0.53,"act":0.58,"surprise":9.02},{"date":"2025-08-06","est":0.59,"act":0.64,"surprise":8.27},{"date":"2025-11-05","est":0.63,"act":0.74,"surprise":16.91},{"date":"2026-02-05","est":0.74,"act":0.81,"surprise":8.95},{"date":"2026-05-06","est":0.62,"act":0.82,"surprise":32.63},{"date":"2026-07-29","est":0.75,"act":0.9,"surprise":20.53},{"date":"2026-10-28","est":0.86,"act":0.91,"surprise":6.0}],"revenue":[{"end":"2025-09-30","revenue":1724900000.0,"eps_gaap":0.62},{"end":"2025-12-31","revenue":1905000000.0,"eps_gaap":0.68},{"end":"2026-03-31","revenue":1849600000.0,"eps_gaap":0.72},{"end":"2026-06-30","revenue":2047900000.0,"eps_gaap":0.82},{"end":"2026-09-30","revenue":2078400000.0,"eps_gaap":0.86}],"next":{"date":null,"eps_est":0.9401,"eps_year_ago":0.81,"n":39,"rev_est":2200307000.0,"rev_gro