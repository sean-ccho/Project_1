 commercializes therapies for chronic eye diseases, focusing on encapsulated cell therapy platforms for ocular conditions. The company was formerly known as Alcon Universal S.A. and changed its name to Alcon Inc. in December 2001. Alcon Inc. was founded in 1945 and is headquartered in Geneva, Switzerland.","detail":{"as_of":"2026-11-13","valuation":{"pe":54.1,"fpe":18.92,"peg":1.26,"ps":3.24,"pb":1.64,"ev_ebitda":15.9,"ind":{"pe":43.09,"fpe":18.73,"peg":1.55,"ps":3.05,"pb":2.85,"ev_ebitda":15.71},"n_peers":28,"industry":"Medical Instruments & Supplies"},"analyst":{"n":16,"mean":82.67,"median":81.5,"high":103.0,"low":63.0,"rec_mean":1.67,"rec_key":"buy","rec":{"strong_buy":4,"buy":17,"hold":5,"sell":0,"strong_sell":1}},"quarters":{"eps":[{"date":"2024-11-12","est":0.74,"act":0.81,"surprise":8.79},{"date":"2025-02-25","est":0.72,"act":0.72,"surprise":0.57},{"date":"2025-05-13","est":0.76,"act":0.73,"surprise":-4.27},{"date":"2025-08-19","est":0.71,"act":0.76,"surprise":6.75},{"date":"2025-11-11","est":0.77,"act":0.79,"surprise":3.0},{"date":"2026-02-24","est":0.79,"act":0.78,"surprise":-1.32},{"date":"2026-05-05","est":0.82,"act":0.85,"surprise":4.06},{"date":"2026-08-10","est":0.76,"act":0.84,"surprise":11.21}],"revenue":[{"end":"2025-06-30","revenue":2596000000.0,"eps_gaap":0.35},{"end":"2025-09-30","revenue":2614000000.0,"eps_gaap":0.48},{"end":"2025-12-31","revenue":2718000000.0,"eps_gaap":0.44},{"end":"2026-03-31","revenue":2706000000.0,"eps_gaap":0.39},{"end":"2026-06-30","revenue":2823000000.0,"eps_gaap":0.0}],"next":{"date":null,"eps_est":0.89,"eps_year_ago":0.79,"n":15,"rev_est":2743081490.0,"rev_growth":0.0494}}},"congress":[{"filed":"2026-09-01","date":"2026-08-05","lag":27,"member":"Kevin Hern","party":"R","state":"OK","leader":"House Republican Policy Committee Chair","owner":"self","type":"sell","partial":false,"atype":"ST","low":1001,"high":15000,"amount":"$1,001 - $15,000","url":"https://disclosures-clerk.house.gov/public_disc/ptr-pdfs/2026/20035326.pd