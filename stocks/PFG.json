 and vision benefits; and individual life insurance products comprising universal, variable universal, indexed universal, and term life insurance products. This segment serves insurance solutions for small and medium-sized businesses and their owners, as well as employees. The company was founded in 1879 and is based in Des Moines, Iowa.","detail":{"as_of":"2026-11-06","valuation":{"pe":12.35,"fpe":11.03,"peg":null,"ps":1.42,"pb":2.0,"ev_ebitda":8.46,"ind":{"pe":13.27,"fpe":10.68,"peg":0.96,"ps":4.63,"pb":2.48,"ev_ebitda":12.48},"n_peers":62,"industry":"Asset Management"},"analyst":{"n":12,"mean":109.42,"median":111.5,"high":125.0,"low":86.0,"rec_mean":3.0,"rec_key":"hold","rec":{"strong_buy":2,"buy":0,"hold":8,"sell":0,"strong_sell":2}},"quarters":{"eps":[{"date":"2025-02-06","est":1.93,"act":1.94,"surprise":0.36},{"date":"2025-04-24","est":1.83,"act":1.81,"surprise":-1.04},{"date":"2025-07-28","est":1.97,"act":2.16,"surprise":9.57},{"date":"2025-10-27","est":2.2,"act":2.1,"surprise":-4.54},{"date":"2026-02-09","est":2.22,"act":2.19,"surprise":-1.57},{"date":"2026-04-23","est":2.01,"act":2.07,"surprise":2.94},{"date":"2026-07-27","est":2.33,"act":2.5,"surprise":7.07},{"date":"2026-10-26","est":2.43,"act":2.22,"surprise":-8.58}],"revenue":[{"end":"2025-09-30","revenue":3681600000.0,"eps_gaap":0.95},{"end":"2025-12-31","revenue":4576700000.0,"eps_gaap":null},{"end":"2026-03-31","revenue":3529100000.0,"eps_gaap":1.93},{"end":"2026-06-30","revenue":3905800000.0,"eps_gaap":1.84},{"end":"2026-09-30","revenue":4616400000.0,"eps_gaap":2.91}],"next":{"date":null,"eps_est":2.414,"eps_year_ago":2.19,"n":10,"rev_est":4469775000.0,"rev_growth":0.0026}}},"congress":[{"filed":"2025-11-21","date":"2025-10-30","lag":22,"member":"Lisa C. McClain","party":"R","state":"MI","leader":"House Republican Conference Chair","owner":"spouse","type":"sell","partial":false,"atype":"ST","low":1001,"high":15000,"amount":"$1,001 - $15,000","url":"https://disclosures-clerk.house.gov/public_disc/ptr