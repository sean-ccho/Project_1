ortfolio accounting, and custody-related services. This segment also offers business process outsourcing services; technology solutions, such portfolio management, compliance, fee billing, and operational support solutions; and capital market and wealth and investment management solutions. The company was founded in 1962 and is headquartered in Lake Success, New York.","detail":{"as_of":"2026-11-06","valuation":{"pe":21.09,"fpe":16.49,"peg":1.95,"ps":2.85,"pb":8.22,"ev_ebitda":13.88,"ind":{"pe":19.36,"fpe":12.29,"peg":1.19,"ps":1.35,"pb":2.88,"ev_ebitda":9.62},"n_peers":40,"industry":"Information Technology Services"},"analyst":{"n":8,"mean":209.25,"median":213.0,"high":230.0,"low":180.0,"rec_mean":2.33,"rec_key":"buy","rec":{"strong_buy":4,"buy":1,"hold":4,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-01-31","est":1.49,"act":1.56,"surprise":4.89},{"date":"2025-05-01","est":2.41,"act":2.44,"surprise":1.17},{"date":"2025-08-05","est":3.5,"act":3.55,"surprise":1.48},{"date":"2025-11-04","est":1.25,"act":1.51,"surprise":21.22},{"date":"2026-02-03","est":1.36,"act":1.59,"surprise":16.81},{"date":"2026-04-30","est":2.6,"act":2.72,"surprise":4.45},{"date":"2026-08-04","est":3.76,"act":3.82,"surprise":1.68},{"date":"2026-11-03","est":1.37,"act":1.56,"surprise":13.96}],"revenue":[{"end":"2025-09-30","revenue":1589400000.0,"eps_gaap":1.4},{"end":"2025-12-31","revenue":1713900000.0,"eps_gaap":2.42},{"end":"2026-03-31","revenue":1953600000.0,"eps_gaap":2.36},{"end":"2026-06-30","revenue":2219900000.0,"eps_gaap":3.44},{"end":"2026-09-30","revenue":1668700000.0,"eps_gaap":0.83}],"next":{"date":"2027-02-02","eps_est":1.6205,"eps_year_ago":1.59,"n":6,"rev_est":1782245170.0,"rev_growth":0.0399}}},"congress":[{"filed":"2026-06-08","date":"2026-05-15","lag":24,"member":"Gilbert Ray Cisneros, Jr.","party":"D","state":"CA","leader":null,"owner":"self","type":"sell","partial":true,"atype":"ST","low":1001,"high":15000,"amount":"$1,001 - $15,000","url":"https://disclosures-c