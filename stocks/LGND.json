logy; Ensifentrine for respiratory disease; QTORIN for rare disease; Sparsentan for kidney disease; VK2809 for hepatology; ANEB-001 for acute cannabinoid intoxication; Reproxalap for opthamology; VK0214 for Rare Disease; and VK5211 for musculoskeletal disorder. The company was incorporated in 1987 and is based in Jupiter, Florida.","detail":{"as_of":"2026-11-27","valuation":{"pe":126.68,"fpe":26.39,"peg":null,"ps":24.86,"pb":6.56,"ev_ebitda":98.17,"ind":{"pe":26.08,"fpe":21.06,"peg":1.69,"ps":10.66,"pb":5.75,"ev_ebitda":29.41},"n_peers":149,"industry":"Biotechnology"},"analyst":{"n":11,"mean":361.27,"median":350.0,"high":406.0,"low":335.0,"rec_mean":null,"rec_key":null,"rec":{"strong_buy":3,"buy":8,"hold":0,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-02-27","est":1.19,"act":1.27,"surprise":6.71},{"date":"2025-05-08","est":1.21,"act":1.33,"surprise":9.69},{"date":"2025-08-07","est":1.42,"act":1.6,"surprise":12.56},{"date":"2025-11-06","est":1.93,"act":3.09,"surprise":60.46},{"date":"2026-02-26","est":1.5,"act":2.02,"surprise":34.92},{"date":"2026-05-07","est":1.8,"act":1.63,"surprise":-9.61},{"date":"2026-08-06","est":1.95,"act":2.37,"surprise":21.48},{"date":"2026-10-29","est":2.33,"act":2.67,"surprise":14.66}],"revenue":[{"end":"2025-09-30","revenue":115461000.0,"eps_gaap":5.68},{"end":"2025-12-31","revenue":59666000.0,"eps_gaap":2.12},{"end":"2026-03-31","revenue":51722000.0,"eps_gaap":-0.67},{"end":"2026-06-30","revenue":63693000.0,"eps_gaap":2.22},{"end":"2026-09-30","revenue":78746000.0,"eps_gaap":-1.43}],"next":{"date":null,"eps_est":2.8807,"eps_year_ago":2.02,"n":10,"rev_est":97796140.0,"rev_growth":0.6391}}},"splits":[["2010-11-19",0.166667],["2022-11-02",1.603]],"congress":[{"filed":"2026-06-08","date":"2026-05-29","lag":10,"member":"Gilbert Ray Cisneros, Jr.","party":"D","state":"CA","leader":null,"owner":"self","type":"buy","partial":false,"atype":"ST","low":1001,"high":15000,"amount":"$1,001 - $15,000","url":"https://disclosures-clerk.hou