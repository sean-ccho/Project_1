itives and detergents under the Ariel, Downy, Gain, and Tide brands; and air and dish care, P&G professional, and surface care under the Cascade, Dawn, Fairy, Febreze, Mr. Clean, and Swiffer brands. Additionally, the company offers baby wipes, taped diapers, and pants under the Luvs and Pampers brands; adult incontinence and menstrual care products under the Always, Always Discreet, and Tampax brands; and paper towels, tissues, and toilet papers under the Bounty, Charmin, and Puffs brands. It sells its products through mass merchandisers, social ecommerce channels, grocery and specialty beauty stores, membership club stores, drug and department stores, distributors, wholesalers, airport duty-free and high-frequency stores, pharmacies, electronics stores, and professional channels, as well as directly to consumers. The company was founded in 1837 and is headquartered in Cincinnati, Ohio.","detail":{"as_of":"2026-11-06","valuation":{"pe":24.91,"fpe":22.35,"peg":4.29,"ps":4.36,"pb":7.05,"ev_ebitda":16.26,"ind":{"pe":25.82,"fpe":17.06,"peg":2.28,"ps":2.81,"pb":5.69,"ev_ebitda":15.52},"n_peers":13,"industry":"Household & Personal Products"},"analyst":{"n":23,"mean":174.04,"median":176.0,"high":190.0,"low":151.0,"rec_mean":2.08,"rec_key":"buy","rec":{"strong_buy":5,"buy":9,"hold":11,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-01-22","est":1.86,"act":1.88,"surprise":1.1},{"date":"2025-04-24","est":1.53,"act":1.54,"surprise":0.93},{"date":"2025-07-29","est":1.42,"act":1.48,"surprise":4.14},{"date":"2025-10-24","est":1.9,"act":1.99,"surprise":4.92},{"date":"2026-01-22","est":1.86,"act":1.88,"surprise":1.25},{"date":"2026-04-24","est":1.56,"act":1.59,"surprise":2.22},{"date":"2026-07-29","est":1.41,"act":1.43,"surprise":1.55},{"date":"2026-10-22","est":1.89,"act":2.0,"surprise":5.66}],"revenue":[{"end":"2025-09-30","revenue":22386000000.0,"eps_gaap":1.95},{"end":"2025-12-31","revenue":22208000000.0,"eps_gaap":1.78},{"end":"2026-03-31","revenue":21235000000.0,"