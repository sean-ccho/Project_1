 and management; reporting and dashboards; questionnaires and collaboration; remediation and workflow; big data correlation and analytics engine; and alerts and notifications. The company offers its solutions to enterprises, government entities, and small and medium-sized businesses in various industries, including education, financial services, government, healthcare, insurance, manufacturing, media, retail, technology, and utilities through its sales teams, as well as through security consulting organizations, managed service providers, resellers, cloud providers, and consulting firms. Qualys, Inc. was incorporated in 1999 and is headquartered in Foster City, California.","detail":{"as_of":"2026-11-13","valuation":{"pe":28.82,"fpe":19.81,"peg":2.97,"ps":8.37,"pb":9.34,"ev_ebitda":21.34,"ind":{"pe":28.08,"fpe":19.3,"peg":1.27,"ps":4.83,"pb":5.23,"ev_ebitda":21.69},"n_peers":75,"industry":"Software - Infrastructure"},"analyst":{"n":18,"mean":196.81,"median":198.5,"high":220.0,"low":140.0,"rec_mean":2.77,"rec_key":"hold","rec":null},"quarters":{"eps":[{"date":"2025-02-06","est":1.37,"act":1.6,"surprise":17.18},{"date":"2025-05-06","est":1.47,"act":1.67,"surprise":13.77},{"date":"2025-08-05","est":1.48,"act":1.68,"surprise":13.34},{"date":"2025-11-04","est":1.56,"act":1.86,"surprise":19.17},{"date":"2026-02-05","est":1.78,"act":1.87,"surprise":4.91},{"date":"2026-05-05","est":1.8,"act":1.95,"surprise":8.38},{"date":"2026-08-04","est":1.78,"act":1.98,"surprise":10.93},{"date":"2026-11-09","est":1.96,"act":2.12,"surprise":8.4}],"revenue":[{"end":"2025-09-30","revenue":169882000.0,"eps_gaap":1.39},{"end":"2025-12-31","revenue":175282000.0,"eps_gaap":1.47},{"end":"2026-03-31","revenue":175638000.0,"eps_gaap":1.42},{"end":"2026-06-30","revenue":182175000.0,"eps_gaap":1.5},{"end":"2026-09-30","revenue":188049000.0,"eps_gaap":1.62}],"next":{"date":"2027-02-02"}}},"congress":[{"filed":"2025-11-21","date":"2025-10-30","lag":22,"member":"Lisa C. McClain","party":"R","state":"MI