 headquartered in Seattle, Washington.","detail":{"as_of":"2026-11-06","valuation":{"pe":246.62,"fpe":53.32,"peg":null,"ps":4.25,"pb":298.94,"ev_ebitda":34.66,"ind":{"pe":12.52,"fpe":12.51,"peg":1.96,"ps":1.47,"pb":2.06,"ev_ebitda":8.66},"n_peers":35,"industry":"Insurance - Property & Casualty"},"analyst":{"n":7,"mean":25.43,"median":25.0,"high":31.0,"low":21.0,"rec_mean":1.29,"rec_key":"strong_buy","rec":{"strong_buy":0,"buy":6,"hold":1,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-02-25","est":0.14,"act":0.09,"surprise":-30.22},{"date":"2025-05-06","est":-0.1,"act":0.04,"surprise":138.9},{"date":"2025-08-05","est":-0.11,"act":0.02,"surprise":117.19},{"date":"2025-11-05","est":-0.05,"act":-0.1,"surprise":-118.77},{"date":"2026-02-11","est":-0.07,"act":-0.03,"surprise":55.88},{"date":"2026-04-28","est":-0.11,"act":-0.04,"surprise":64.29},{"date":"2026-07-29","est":-0.02,"act":0.05,"surprise":385.71},{"date":"2026-10-28","est":0.02,"act":0.1,"surprise":328.63}],"revenue":[{"end":"2025-09-30","revenue":127288000.0,"eps_gaap":-0.1},{"end":"2025-12-31","revenue":167585000.0,"eps_gaap":-0.03},{"end":"2026-03-31","revenue":121123000.0,"eps_gaap":-0.04},{"end":"2026-06-30","revenue":140882000.0,"eps_gaap":0.05},{"end":"2026-09-30","revenue":143860000.0,"eps_gaap":0.1}],"next":{"date":null,"eps_est":0.015,"eps_year_ago":-0.03,"n":4,"rev_est":143945330.0,"rev_growth":0.2823}}}}