, LEAR, CONFIGURE+, FLEXAIR, INTU, RENEWKNIT, SOYFOAM, ProTec, and TeXstyle brands. The company was founded in 1917 and is headquartered in Southfield, Michigan.","detail":{"as_of":"2026-11-06","valuation":{"pe":9.61,"fpe":6.59,"peg":null,"ps":0.22,"pb":1.06,"ev_ebitda":4.76,"ind":{"pe":19.66,"fpe":9.42,"peg":0.56,"ps":0.69,"pb":1.63,"ev_ebitda":7.1},"n_peers":28,"industry":"Auto Parts"},"analyst":{"n":14,"mean":145.93,"median":142.5,"high":179.0,"low":121.0,"rec_mean":2.44,"rec_key":"buy","rec":{"strong_buy":1,"buy":4,"hold":11,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-02-06","est":2.58,"act":2.94,"surprise":14.04},{"date":"2025-05-06","est":2.7,"act":3.12,"surprise":15.68},{"date":"2025-07-25","est":3.3,"act":3.47,"surprise":5.09},{"date":"2025-10-31","est":2.79,"act":2.79,"surprise":-0.09},{"date":"2026-02-04","est":2.8,"act":3.41,"surprise":21.79},{"date":"2026-05-01","est":3.51,"act":3.87,"surprise":10.38},{"date":"2026-07-31","est":3.98,"act":4.28,"surprise":7.6},{"date":"2026-10-30","est":3.32,"act":3.71,"surprise":11.62}],"revenue":[{"end":"2025-09-30","revenue":5679800000.0,"eps_gaap":2.02},{"end":"2025-12-31","revenue":5988600000.0,"eps_gaap":1.58},{"end":"2026-03-31","revenue":5822800000.0,"eps_gaap":3.34},{"end":"2026-06-30","revenue":6209400000.0,"eps_gaap":3.79},{"end":"2026-09-30","revenue":5773000000.0,"eps_gaap":2.74}],"next":{"date":null,"eps_est":3.2697,"eps_year_ago":3.41,"n":12,"rev_est":5799692540.0,"rev_growth":-0.0315}}}}