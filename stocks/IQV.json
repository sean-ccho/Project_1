ffers project management and clinical monitoring; clinical trial support; strategic planning and design services; and patient and site centric solutions, as well as central laboratory, genomic, bioanalytical, ADME, discovery, vaccine and biomarker laboratory services. The Contract Sales & Medical Solutions segment provides health care provider and patient engagement services, and scientific strategy and medical services. It serves pharmaceutical, biotechnology, device and diagnostic, and consumer health companies. The company has a strategic collaboration with Kexing Biopharm Co., Ltd. for biosimilar development. The company was formerly known as Quintiles IMS Holdings, Inc. and changed its name to IQVIA Holdings Inc. in November 2017. IQVIA Holdings Inc. is based in Durham, North Carolina.","detail":{"as_of":"2026-11-13","valuation":{"pe":32.25,"fpe":18.67,"peg":1.0,"ps":2.52,"pb":6.56,"ev_ebitda":18.83,"ind":{"pe":36.31,"fpe":25.98,"peg":1.67,"ps":5.67,"pb":5.01,"ev_ebitda":24.6},"n_peers":30,"industry":"Diagnostics & Research"},"analyst":{"n":18,"mean":311.89,"median":310.0,"high":346.0,"low":268.0,"rec_mean":1.3,"rec_key":"strong_buy","rec":{"strong_buy":2,"buy":16,"hold":2,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-02-06","est":3.11,"act":3.12,"surprise":0.36},{"date":"2025-05-06","est":2.63,"act":2.7,"surprise":2.57},{"date":"2025-07-22","est":2.77,"act":2.81,"surprise":1.43},{"date":"2025-10-28","est":2.98,"act":3.0,"surprise":0.81},{"date":"2026-02-05","est":3.4,"act":3.42,"surprise":0.69},{"date":"2026-05-05","est":2.82,"act":2.9,"surprise":2.96},{"date":"2026-07-28","est":3.03,"act":3.15,"surprise":3.94},{"date":"2026-10-27","est":3.28,"act":3.34,"surprise":1.96}],"revenue":[{"end":"2025-09-30","revenue":4100000000.0,"eps_gaap":1.93},{"end":"2025-12-31","revenue":4364000000.0,"eps_gaap":2.99},{"end":"2026-03-31","revenue":4151000000.0,"eps_gaap":1.61},{"end":"2026-06-30","revenue":4368000000.0,"eps_gaap":1.53},{"end":"2026-09-30","revenue"