 as Reynolds, Diamond, or Hefty Basics depending on region. This segment also includes the specialty business providing Fresh-Lock and Slide-Rite resealable closure systems. Reynolds Consumer Products Inc. was founded in 1947 and is headquartered in Lake Forest, Illinois. Reynolds Consumer Products Inc. operates as a subsidiary of Packaging Finance Limited.","detail":{"as_of":"2026-11-27","valuation":{"pe":16.95,"fpe":15.24,"peg":null,"ps":1.44,"pb":2.35,"ev_ebitda":10.85,"ind":{"pe":20.18,"fpe":13.65,"peg":1.21,"ps":0.89,"pb":1.82,"ev_ebitda":9.03},"n_peers":16,"industry":"Packaging & Containers"},"analyst":{"n":7,"mean":27.0,"median":27.0,"high":30.0,"low":24.0,"rec_mean":null,"rec_key":null,"rec":{"strong_buy":0,"buy":2,"hold":5,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-02-05","est":0.58,"act":0.58,"surprise":0.36},{"date":"2025-04-30","est":0.23,"act":0.23,"surprise":-0.55},{"date":"2025-07-30","est":0.38,"act":0.39,"surprise":3.89},{"date":"2025-10-29","est":0.39,"act":0.42,"surprise":6.84},{"date":"2026-02-04","est":0.59,"act":0.59,"surprise":0.09},{"date":"2026-05-06","est":0.24,"act":0.28,"surprise":14.47},{"date":"2026-07-29","est":0.4,"act":0.42,"surprise":4.04},{"date":"2026-11-04","est":0.38,"act":0.39,"surprise":1.44}],"revenue":[{"end":"2025-09-30","revenue":931000000.0,"eps_gaap":0.38},{"end":"2025-12-31","revenue":1034000000.0,"eps_gaap":0.56},{"end":"2026-03-31","revenue":877000000.0,"eps_gaap":0.28},{"end":"2026-06-30","revenue":944000000.0,"eps_gaap":0.42},{"end":"2026-09-30","revenue":944000000.0,"eps_gaap":0.28}],"next":{"date":"2027-02-10","eps_est":0.5228,"eps_year_ago":0.59,"n":7,"rev_est":1042592000.0,"rev_growth":0.0083}}}}