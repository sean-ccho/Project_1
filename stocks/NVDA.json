h Cisco to develop Ultra-Dense Small Form Factor Pluggable (USFP), a high-density optical module pluggable transceiver. It has a collaboration with ChipAgents to develop Build-A-Chip-Bench, a benchmark for AI agents carrying chip design tasks and The Company has a strategic alliance with MediaTek to build the next generations of AI computing platforms. NVIDIA Corporation was incorporated in 1993 and is headquartered in Santa Clara, California.","detail":{"as_of":"2026-11-20","valuation":{"pe":13.48,"fpe":7.56,"peg":0.18,"ps":8.38,"pb":11.35,"ev_ebitda":12.19,"ind":{"pe":39.55,"fpe":16.5,"peg":0.51,"ps":5.71,"pb":4.86,"ev_ebitda":21.3},"n_peers":43,"industry":"Semiconductors"},"analyst":{"n":56,"mean":244.18,"median":235.0,"high":425.0,"low":130.0,"rec_mean":1.81,"rec_key":"buy","rec":null},"quarters":{"eps":[{"date":"2025-02-26","est":0.85,"act":0.89,"surprise":5.25},{"date":"2025-05-28","est":0.75,"act":0.81,"surprise":8.02},{"date":"2025-08-27","est":1.01,"act":1.05,"surprise":4.1},{"date":"2025-11-19","est":1.26,"act":1.3,"surprise":3.46},{"date":"2026-02-25","est":1.54,"act":1.62,"surprise":5.32},{"date":"2026-05-20","est":1.77,"act":1.87,"surprise":5.54},{"date":"2026-08-26","est":2.09,"act":2.22,"surprise":6.16},{"date":"2026-11-17","est":2.47,"act":2.68,"surprise":8.36}],"revenue":[{"end":"2025-07-31","revenue":46743000000.0,"eps_gaap":null},{"end":"2025-10-31","revenue":57006000000.0,"eps_gaap":1.3},{"end":"2026-01-31","revenue":68127000000.0,"eps_gaap":1.76},{"end":"2026-04-30","revenue":81615000000.0,"eps_gaap":2.39},{"end":"2026-07-31","revenue":96221000000.0,"eps_gaap":2.46}],"next":{"date":null}}},"splits":[["2000-06-27",2.0],["2001-09-10",2.0],["2006-04-07",2.0],["2007-09-11",1.5],["2021-07-20",4.0],["2024-06-10",10.0]],"congress":[{"filed":"2026-11-18","date":"2026-10-28","lag":21,"member":"Michael A. Rulli","party":"R","state":"OH","leader":null,"owner":"self","type":"sell","partial":true,"atype":"ST","low":1001,"high":15000,"amount":"$1,001 - $15,00