ime, RONIA, SimplicityChrom, Specimen Gate, Superflex, Symbio, T-SPOT, Vanadis, ViaCord, VICTOR2, and WholePanel brand names, as well as under the Accell, AlphaLISA, AlphaPlex, AlphaScreen, Alpha SureFire, AssayMate, BIOCHIPs, BioLegend, Bioo Scientific, BioQule, Brilliant Violet, Ce3D, CellCarrier, Cellaca, Celigo, Cellometer, cell::explorer, Cell-Vive, Chalice, ChemDraw, CHOSOURCE, Dharmacon, and DharmaFECT brand names. The company was formerly known as PerkinElmer, Inc. and changed its name to Revvity, Inc. in April 2023. Revvity, Inc. was founded in 1937 and is headquartered in Waltham, Massachusetts.","detail":{"as_of":"2026-11-13","valuation":{"pe":68.62,"fpe":25.9,"peg":0.97,"ps":5.86,"pb":2.37,"ev_ebitda":21.81,"ind":{"pe":36.31,"fpe":25.98,"peg":1.67,"ps":5.67,"pb":5.01,"ev_ebitda":24.6},"n_peers":30,"industry":"Diagnostics & Research"},"analyst":{"n":15,"mean":171.07,"median":175.0,"high":200.0,"low":122.0,"rec_mean":2.39,"rec_key":"buy","rec":{"strong_buy":0,"buy":6,"hold":11,"sell":0,"strong_sell":1}},"quarters":{"eps":[{"date":"2025-01-31","est":1.38,"act":1.42,"surprise":3.1},{"date":"2025-04-28","est":0.95,"act":1.01,"surprise":6.39},{"date":"2025-07-28","est":1.14,"act":1.18,"surprise":3.36},{"date":"2025-10-27","est":1.14,"act":1.18,"surprise":3.63},{"date":"2026-02-02","est":1.58,"act":1.7,"surprise":7.8},{"date":"2026-05-05","est":1.01,"act":1.06,"surprise":4.47},{"date":"2026-08-04","est":1.22,"act":1.41,"surprise":15.93},{"date":"2026-11-03","est":1.3,"act":1.37,"surprise":5.68}],"revenue":[{"end":"2025-06-30","revenue":720284000.0,"eps_gaap":null},{"end":"2025-09-30","revenue":698949000.0,"eps_gaap":0.4},{"end":"2025-12-31","revenue":772056000.0,"eps_gaap":0.87},{"end":"2026-03-31","revenue":711118000.0,"eps_gaap":0.36},{"end":"2026-06-30","revenue":729688000.0,"eps_gaap":0.4645}],"next":{"date":"2027-02-01","eps_est":1.6236,"eps_year_ago":1.7,"n":12,"rev_est":766697850.0,"rev_growth":-0.0069}}},"congress":[{"filed":"2026-11-10","date":"2026-10