iosciences segment offers enzymes, food cultures, probiotics and specialty ingredients for food and non-food applications, as well as engages in health, food biosciences, home and personal care, animal nutrition and grain processing businesses. The Scent segment creates fragrance compounds, and fragrance ingredients. International Flavors & Fragrances Inc. was incorporated in 1909 and is headquartered in New York, New York.","detail":{"as_of":"2026-11-13","valuation":{"pe":231.89,"fpe":20.99,"peg":1.98,"ps":1.87,"pb":1.53,"ev_ebitda":14.31,"ind":{"pe":28.77,"fpe":15.53,"peg":1.86,"ps":1.81,"pb":2.79,"ev_ebitda":11.55},"n_peers":36,"industry":"Specialty Chemicals"},"analyst":{"n":17,"mean":98.24,"median":100.0,"high":110.0,"low":76.0,"rec_mean":1.9,"rec_key":"buy","rec":{"strong_buy":5,"buy":9,"hold":5,"sell":0,"strong_sell":1}},"quarters":{"eps":[{"date":"2025-02-18","est":0.82,"act":0.97,"surprise":17.6},{"date":"2025-05-06","est":1.14,"act":1.2,"surprise":5.68},{"date":"2025-08-05","est":1.12,"act":1.15,"surprise":2.53},{"date":"2025-11-04","est":1.02,"act":1.05,"surprise":3.32},{"date":"2026-02-11","est":0.83,"act":0.8,"surprise":-3.81},{"date":"2026-05-05","est":1.07,"act":1.25,"surprise":16.51},{"date":"2026-08-04","est":1.12,"act":0.82,"surprise":-26.57},{"date":"2026-11-03","est":0.82,"act":0.83,"surprise":1.8}],"revenue":[{"end":"2025-09-30","revenue":1869000000.0,"eps_gaap":0.16},{"end":"2025-12-31","revenue":2589000000.0,"eps_gaap":0.07},{"end":"2026-03-31","revenue":2741000000.0,"eps_gaap":0.66},{"end":"2026-06-30","revenue":1954000000.0,"eps_gaap":0.2},{"end":"2026-09-30","revenue":1942000000.0,"eps_gaap":-0.22}],"next":{"date":null,"eps_est":0.6299,"eps_year_ago":0.8,"n":14,"rev_est":1819831540.0,"rev_growth":-0.2971}}},"congress":[{"filed":"2025-12-15","date":"2025-11-18","lag":27,"member":"Gilbert Ray Cisneros, Jr.","party":"D","state":"CA","leader":null,"owner":"self","type":"buy","partial":false,"atype":"ST","low":1001,"high":15000,"amount":"$1,001 