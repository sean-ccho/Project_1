dhesives, and Cyrel flexographic printing plates. The company was formerly known as DowDuPont Inc. and changed its name to DuPont de Nemours, Inc. in June 2019. DuPont de Nemours, Inc. was incorporated in 2015 and is headquartered in Wilmington, Delaware.","detail":{"as_of":"2026-11-06","valuation":{"pe":51.05,"fpe":18.0,"peg":null,"ps":2.75,"pb":1.43,"ev_ebitda":12.85,"ind":{"pe":27.66,"fpe":15.44,"peg":1.92,"ps":1.85,"pb":2.65,"ev_ebitda":11.21},"n_peers":36,"industry":"Specialty Chemicals"},"analyst":{"n":17,"mean":169.35,"median":169.0,"high":186.0,"low":145.0,"rec_mean":1.61,"rec_key":"buy","rec":{"strong_buy":3,"buy":11,"hold":4,"sell":0,"strong_sell":0}},"quarters":{"eps":[{"date":"2025-02-11","est":2.94,"act":3.39,"surprise":15.33},{"date":"2025-05-02","est":2.86,"act":3.09,"surprise":8.14},{"date":"2025-08-05","est":3.18,"act":3.36,"surprise":5.54},{"date":"2025-11-06","est":2.94,"act":3.27,"surprise":11.16},{"date":"2026-02-10","est":1.29,"act":1.38,"surprise":6.6},{"date":"2026-05-05","est":1.45,"act":1.65,"surprise":13.58},{"date":"2026-08-04","est":1.76,"act":1.88,"surprise":6.75},{"date":"2026-11-03","est":1.88,"act":2.09,"surprise":11.46}],"revenue":[{"end":"2025-06-30","revenue":1749000000.0,"eps_gaap":null},{"end":"2025-09-30","revenue":1795000000.0,"eps_gaap":-0.88},{"end":"2026-03-31","revenue":1681000000.0,"eps_gaap":1.17},{"end":"2026-09-30","revenue":1868000000.0,"eps_gaap":0.91}],"next":{"date":null,"eps_est":1.9025,"eps_year_ago":1.38,"n":14,"rev_est":1824066280.0,"rev_growth":0.0774}}},"congress":[{"filed":"2026-09-04","date":"2026-07-17","lag":49,"member":"Gilbert Ray Cisneros, Jr.","party":"D","state":"CA","leader":null,"owner":"self","type":"sell","partial":false,"atype":"ST","low":1001,"high":15000,"amount":"$1,001 - $15,000","url":"https://disclosures-clerk.house.gov/public_disc/ptr-pdfs/2026/20035190.pdf"},{"filed":"2026-02-13","date":"2026-01-09","lag":35,"member":"Gilbert Ray Cisneros, Jr.","party":"D","state":"CA","leader":null,"own