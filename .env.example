# ══════════════════════════════════════════════════════════════
# 퀀트 트레이딩 시스템 — 환경변수 설정 템플릿
# ══════════════════════════════════════════════════════════════
# 이 파일을 `.env`로 복사한 뒤 값을 채워주세요.
#   cp .env.example .env
#
# CI/CD에서는 GitHub Secrets로 관리됩니다.
# ──────────────────────────────────────────────────────────────

# === 이메일 알림 ===
EMAIL_PASSWORD=                       # Gmail 앱 비밀번호 (2FA 필수)

# === 개발 모드 ===
# DEV_MODE=1                          # 소수 종목(13개)으로 빠르게 테스트

# === Google Sheets ===
# GOOGLE_SERVICE_ACCOUNT_JSON=        # 서비스 계정 JSON (CI에서는 secret)

# === 운영 오버라이드 (선택) ===
# PT_MAX_POSITIONS=3                  # 페이퍼 트레이딩 최대 포지션 수
# EMAIL_ENABLED=true                  # 이메일 알림 on/off
# CHARTS_ENABLED=false                # 차트 캡처 on/off
# LOG_LEVEL=INFO                      # 로그 레벨 (DEBUG/INFO/WARNING/ERROR)
